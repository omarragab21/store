{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-module" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-banner" class="form-horizontal">
        <ul class="nav nav-tabs">
            <li class="active"><a href="#tab-general" data-toggle="tab">Genaral setting</a></li>
            <li><a href="#tab-data" data-toggle="tab">Form field</a></li>
        </ul>
        <div class="tab-content">
            <div class="tab-pane active" id="tab-general">
				<div class="form-group">
					<label class="col-sm-2 control-label" for="input-name">Module name</label>
					<div class="col-sm-10">
					  <input type="hidden" name="jform_id" value="{{ jform_id }}" />
					  <input type="text" name="name" value="{{ name }}" placeholder="Module name" id="input-name" class="form-control" />
					  {% if error_name %}
					  <div class="text-danger">{{ error_name }}</div>
					  {% endif %}
					</div>
				</div>
				
				<div class="form-group">
					<label class="col-sm-2 control-label" for="input-name">Form heading title</label>
					<div class="col-sm-10">
					{% for language in languages %}
                        <div class="input-group"><span class="input-group-addon"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" /></span>
                          <input type="text" name="jform_description[{{ language.language_id }}][title]" value="{{ jform_description[language.language_id] ? jform_description[language.language_id].heading_title }}" placeholder="Form heading title" class="form-control" />
                        </div>
					{% endfor %}
					</div>
				</div>
								
				<div class="form-group">
					<label class="col-sm-2 control-label" for="input-title">Email</label>
					<div class="col-sm-10">
					  <input type="text" name="email" value="{{ email }}" placeholder="Admin email" id="input-email" class="form-control" />
					</div>
				</div>
				
				<div class="form-group" style="display: none;">
				<label class="col-sm-2 control-label" for="input-status">Display on
				</label>
				<div class="col-sm-10">
				  <span class="help">Form will display on the top content of this page</span>
				  <select name="information_id" id="input-return" class="form-control">
                      <option value="0">-- None --</option>
                      
                    </select>
				</div>
				</div>
				
				<div class="form-group">
				<label class="col-sm-2 control-label" for="input-status">Form Width</label>
				<div class="col-sm-10">
				  <select name="form_width" id="input-formwidth" class="form-control">
					{% for key, col in cols %}
					<option value="{{ key }}" {% if key == form_width %} selected  {% endif %}>{{ col }}</option>
					{% endfor %}
				  </select>
				</div>
				</div>
				
				<div class="form-group">
				<label class="col-sm-2 control-label" for="input-status">Captcha</label>
				<div class="col-sm-10">
				  <select name="captcha" id="input-status" class="form-control">
					{% if captcha %}
					<option value="1" selected="selected">{{ text_enabled }}</option>
					<option value="0">{{ text_disabled }}</option>
					{% else %}
					<option value="1">{{ text_enabled }}</option>
					<option value="0" selected="selected">{{ text_disabled }}</option>
					{% endif %}
				  </select>
				</div>
				</div>
				
				<div class="form-group">
					<label class="col-sm-2 control-label" for="input-max_file_upload">Max file upload(1000 <=> 1mb)</label>
					<div class="col-sm-10">
					  <input type="text" name="max_file_upload" value="{{ max_file_upload }}" placeholder="Max file upload" id="input-max_file_upload" class="form-control" />
					</div>
				</div>
				
				<div class="form-group">
					<label class="col-sm-2 control-label" for="input-file_allow">File Allow</label>
					<div class="col-sm-10">
					  <input type="text" name="file_allow" value="{{ file_allow }}" placeholder="File allow" id="input-file_allow" class="form-control" />
					</div>
				</div>
				
				<div class="form-group">
					<label class="col-sm-2 control-label" for="input-name">Form Description</label>
					<div class="col-sm-10">
					{% for language in languages %}
                        <div class="input-group"><span class="input-group-addon"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" /></span>
                          <textarea id="jform_description-{{ language.language_id }}" name="jform_description[{{ language.language_id }}][admin_body]" rows="5" placeholder="Form Description"  data-toggle="summernote" class="form-control" >{{ jform_description[language.language_id] ? jform_description[language.language_id].admin_body }}</textarea>
                        </div>
                    {% endfor %}
					</div>
				</div>
				
				<div class="form-group">
					<label class="col-sm-2 control-label" for="input-name">Admin subject</label>
					<div class="col-sm-10">
					{% for language in languages %}
                        <div class="input-group"><span class="input-group-addon"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" /></span>
                          <input type="text" name="jform_description[{{ language.language_id }}][admin_subject]" value="{{ jform_description[language.language_id] ? jform_description[language.language_id].admin_subject }}" placeholder="Admin subject" class="form-control" />
                        </div>
                    {% endfor %}
					</div>
				</div>
				
				<div class="form-group required">
					<label class="col-sm-2 control-label" for="input-name">Message after form submited</label>
					<div class="col-sm-10">
					{% for language in languages %}
                        <div class="input-group"><span class="input-group-addon"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" /></span>
                          <input type="text" name="jform_description[{{ language.language_id }}][message]" value="{{ jform_description[language.language_id] ? jform_description[language.language_id].message }}" placeholder="Success! Thank for your request" class="form-control" />
                        </div>
                    {% endfor %}
					</div>
				</div>
				
				<div class="form-group required">
					<label class="col-sm-2 control-label" for="input-name">Send button name</label>
					<div class="col-sm-10">
					{% for language in languages %}
                        <div class="input-group"><span class="input-group-addon"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" /></span>
                          <input type="text" name="jform_description[{{ language.language_id }}][send_button]" value="{{ jform_description[language.language_id] ? jform_description[language.language_id].send_button }}" placeholder="send to us" class="form-control" />
                        </div>
                    {% endfor %}
					</div>
				</div>
				
				<div class="form-group">
				<label class="col-sm-2 control-label" for="input-status">Respone to customer?</label>
				<div class="col-sm-10">
				  <select name="respone" id="input-status" class="form-control">
					{% if (respone) %}
					<option value="1" selected="selected">{{ text_enabled }}</option>
					<option value="0">{{ text_disabled }}</option>
					{% else %}
					<option value="1">{{ text_enabled }}</option>
					<option value="0" selected="selected">{{ text_disabled }}</option>
					{% endif %}
				  </select>
				</div>
				</div>
				
				<div class="form-group">
					<label class="col-sm-2 control-label" for="input-name">Customer subject</label>
					<div class="col-sm-10">
					{% for language in languages %}
                        <div class="input-group"><span class="input-group-addon"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" /></span>
                          <input type="text" name="jform_description[{{ language.language_id }}][customer_subject]" value="{{ jform_description[language.language_id] ? jform_description[language.language_id].customer_subject }}" placeholder="customer subject" class="form-control" />
                        </div>
                    {% endfor %}
					</div>
				</div>
				<div class="form-group">
					<label class="col-sm-2 control-label" for="input-name">Customer Messege</label>
					<div class="col-sm-10">
					{% for language in languages %}
                        <div class="input-group"><span class="input-group-addon"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" /></span>
                          <textarea name="jform_description[{{ language.language_id }}][customer_body]" rows="5" placeholder="customer messege"  data-toggle="summernote" class="form-control" >{{ jform_description[language.language_id] ? jform_description[language.language_id].customer_body }}</textarea>
                        </div>
                    {% endfor %}
					</div>
				</div>
				
				<div class="form-group">
				<label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
				<div class="col-sm-10">
				  <select name="status" id="input-status" class="form-control">
					{% if (status) %}
					<option value="1" selected="selected">{{ text_enabled }}</option>
					<option value="0">{{ text_disabled }}</option>
					{% else %}
					<option value="1">{{ text_enabled }}</option>
					<option value="0" selected="selected">{{ text_disabled }}</option>
					{% endif %}
				  </select>
				</div>
				</div>
			</div>
			
			<div class="tab-pane" id="tab-data">
				<div>
				<b>Select, checkbox, radio, multiselect: </b> value <=> A,B,C <br />
				<b>One line text, textarea, email: </b> Value <=> placeholder <br />
				</div>
				<div class="table-responsive">
                <table id="jform" class="table table-striped table-bordered table-hover">
                  <thead>
                    <tr>
                      <td class="text-left">Sort order</td>
                      <td class="text-left">Type</td>
                      <td class="text-left">Value</td>
                      <td class="text-left">Require</td>
                      <td class="text-left">Title</td>
                      <td class="text-left">Warming message</td>
					  <td> Width </td>
					  <td></td>
                    </tr>
                  </thead>
                  <tbody>
                    {% set jform_row = 0 %}
                    {% for field in fields %}
                    <tr id="jform-row{{ jform_row }}">
					  <td>
						<input type="text" cols="5" value="{{ field.sort_order }}" name="field[{{ jform_row }}][sort_order]" class="form-control"/>
					  </td>
					  <td>
						<select name="field[{{ jform_row }}][type]" id="input-type" class="form-control">
						<optgroup label="{{ text_choose }}">
						{% if (field.type == 'select') %}
						<option value="select" selected="selected">{{ text_select }}</option>
						{%  else %}
						<option value="select">{{ text_select }}</option>
						{% endif %}
						{% if (field.type == 'radio') %}
						<option value="radio" selected="selected">{{ text_radio }}</option>
						{%  else %}
						<option value="radio">{{ text_radio }}</option>
						{% endif %}
						{% if (field.type == 'checkbox') %}
						<option value="checkbox" selected="selected">{{ text_checkbox }}</option>
						{%  else %}
						<option value="checkbox">{{ text_checkbox }}</option>
						{% endif %}
						{% if (field.type == 'multiselect') %}
						<option value="multiselect" selected="selected">{{ text_multiselect }}</option>
						{%  else %}
						<option value="multiselect">{{ text_multiselect }}</option>
						{% endif %}
						</optgroup>
						<optgroup label="{{ text_input }}">
						{% if (field.type == 'email') %}
						<option value="email" selected="selected">Email address</option>
						{%  else %}
						<option value="email">Email address</option>
						{% endif %}
						{% if (field.type == 'text') %}
						<option value="text" selected="selected">{{ text_text }}</option>
						{%  else %}
						<option value="text">{{ text_text }}</option>
						{% endif %}
						{% if (field.type == 'textarea') %}
						<option value="textarea" selected="selected">{{ text_textarea }}</option>
						{%  else %}
						<option value="textarea">{{ text_textarea }}</option>
						{% endif %}
						</optgroup>
						<optgroup label="{{ text_file }}">
						{% if (field.type == 'file') %}
						<option value="file" selected="selected">{{ text_file }}</option>
						{%  else %}
						<option value="file">{{ text_file }}</option>
						{% endif %}
						</optgroup>
						<optgroup label="{{ text_date }}">
						{% if (field.type == 'date') %}
						<option value="date" selected="selected">{{ text_date }}</option>
						{%  else %}
						<option value="date">{{ text_date }}</option>
						{% endif %}
	
						{% if (field.type == 'datetime') %}
						<option value="datetime" selected="selected">{{ text_datetime }}</option>
						{%  else %}
						<option value="datetime">{{ text_datetime }}</option>
						{% endif %}
						</optgroup>
					  </select>
					  </td>
					  
                      <td class="text-left" style="width: 20%;">
					    <input type="text" name="field[{{ jform_row }}][value]" value="{{ field.value }}" placeholder="" class="form-control" />
                        <input type="hidden" name="field[{{ jform_row }}][jform_field_id]" value="{{ field.jform_field_id }}" />
					  </td>
					  
					  <td>
						<input type="checkbox" value="1" name="field[{{ jform_row }}][require]" {{ field.require ? 'checked' : '' }} class="form-control" />
					  </td>
					  
                      <td class="text-left">
					   {% for language in languages %}
                        <div class="input-group"><span class="input-group-addon"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" /></span>
                          <input type="text" name="field[{{ jform_row }}][field_description][{{ language.language_id }}][title]" value="{{ field.field_description[language.language_id] ? field.field_description[language.language_id].title }}" placeholder="Field title" class="form-control" />
                        </div>
                        {% endfor %}
					  </td>
					  
					  <td class="text-left">
					   {% for language in languages %}
                        <div class="input-group"><span class="input-group-addon"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" /></span>
                          <input type="text" name="field[{{ jform_row }}][field_description][{{ language.language_id }}][text_error]" value="{{ field.field_description[language.language_id]? field.field_description[language.language_id].text_error }}" placeholder="Error message if this field is require" class="form-control" />
                        </div>
                       {% endfor %}
					  </td>
					  
					  <td>
					   <select name="field[{{ jform_row }}][width]" id="input-width" class="form-control">
						{% for key,col in cols %}
						<option value="{{ key }}" {{ (key == field.width)? 'selected' : '' }} > {{ col }}</option>
						{% endfor %}
					   </select>
					  </td>
                      <td class="text-left"><button type="button" onclick="('#jform-row{{ jform_row }}').remove();" data-toggle="tooltip" title="Remove" class="btn btn-danger"><i class="fa fa-minus-circle"></i></button></td>
                    </tr>
                    {% set jform_row = jform_row + 1 %}
                    {% endfor %}
                  </tbody>
                  <tfoot>
                    <tr>
                      <td colspan="7"></td>
                      <td class="text-left"><button type="button" onclick="addField();" data-toggle="tooltip" title="Add field" class="btn btn-primary"><i class="fa fa-plus-circle"></i></button></td>
                    </tr>
                  </tfoot>
                </table>
              </div>
				
			</div>
		</div> 
        </form>
      </div>
    </div>
  </div>
</div>

 <script type="text/javascript" src="view/javascript/summernote/summernote.js"></script>
  <link href="view/javascript/summernote/summernote.css" rel="stylesheet" />
  <script type="text/javascript" src="view/javascript/summernote/summernote-image-attributes.js"></script>
  <script type="text/javascript" src="view/javascript/summernote/opencart.js"></script>
  
<script type="text/javascript"><!--
var jform_row = {{ jform_row }};

function addField() {
    html  = '<tr id="jform-row' + jform_row + '">';
	html += '  <td class="text-left"><input type="text" name="field[' + jform_row + '][sort_order]" value="' + (jform_row + 1) + '" class="form-control" /></td>';
	html += '  <td class="text-left" style="width: 10%;">';
	html += '  <select name="field[' + jform_row + '][type]" class="form-control">';
	html += '  <optgroup label="Choose">';
	html += '  <option value="select">Select</option>';

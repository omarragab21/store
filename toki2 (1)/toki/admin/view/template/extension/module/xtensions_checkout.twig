              <td style="width: 30%;">
              <select name="import_store_id" class="form-control">
              <option value="0" {{ store_id == 0?'selected="selected"':'' }}>{{ default_heading }}</option>			  
	          {% for store in stores %} 
	  		  <option value="{{ store.store_id }}" {{ store_id == store.store_id?'selected="selected"':'' }}>{{ store.name }}</option>
	          {% endfor %} 
			  </select>
	  		  </td>              
        	  <td> 
        	  <input type="submit" value="{{ button_submit }}" data-toggle="tooltip" title="{{ button_import_settings }}" class="btn btn-primary" />
        	  </td>
              </tr>                                                       
</table>
</form>

{{ header }}{{ column_left }} 
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %} 
        <li><a href="{{ breadcrumb['href'] }}">{{ breadcrumb['text'] }}</a></li>
        {% endfor %} 
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if (error_warning) %} 
    <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }} 
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %} 
	 {% if (success) %} 
    <div class="alert alert-success"><i class="fa fa-exclamation-circle"></i> {{ success }} 
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %} 
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_form }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-mail" class="form-horizontal">
    
      <div class="tab-content">
        <div class="tab-pane active" id="tab-mail">
          <div class="tab-content">
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-emailtype"><span data-toggle="tooltip" title="{{ entry_mailtemp }}">{{ entry_mailtemp }}</span></label>
              <div class="col-sm-10">
                <select name="emailtemplate" class="form-control">
                  <option value="">{{ text_select}}</option>
                  {% for result in mailtemplates %} 
                  {% if (emailtemplate == result['mail_id']) %} 
                    <option value="{{ result['mail_id'] }}" selected="selected">{{ result['name'] }}</option> 
                  {% else %} 
                    <option value="{{ result['mail_id'] }}">{{ result['name'] }}</option> 
                  {% endif %} 
                  {% endfor %} 
                </select> 
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-emailtype"><span data-toggle="tooltip" title="Subscriber List">{{ entry_subscriber }}</span></label>

              <div class="col-sm-10">
                <select name="status" class="form-control">
                  {% for result in statuss %} 
                  {% if (status == result['value']) %} 
                    <option value="{{ result['value'] }}" selected="selected">{{ result['name'] }}</option> 
                  {% else %} 
                    <option value="{{ result['value'] }}">{{ result['name'] }}</option> 
                  {% endif %} 
                  {% endfor %} 
                </select> 
              </div>
            </div>

            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-accounts"><span data-toggle="tooltip" title="{{ entry_type }}">{{ entry_type }}</span></label>
              <div class="col-sm-10">
                <select name="account" class="form-control">
                  {% for result in accounts %} 
                  {% if (account == result['value']) %} 
                    <option value="{{ result['value'] }}" selected="selected">{{ result['name'] }}</option> 
                  {% else %} 
                    <option value="{{ result['value'] }}">{{ result['name'] }}</option> 
                  {% endif %} 
                  {% endfor %} 
                </select> 
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-accounts"><span data-toggle="tooltip" title="{{ entry_store }}">{{ entry_store }}</span></label>
              <div class="col-sm-10">
                <select name="store_id" id="input-store" class="form-control">
                <option value="0">{{ text_default }}</option>
                {% for store in stores %} 
                <option value="{{ store['store_id'] }}">{{ store['name'] }}</option>
                {% endfor %} 
              </select> 
              </div>
            </div>
         <div class="form-group">
            <div class="col-sm-10">
              <button type="submit" data-toggle="tooltip" class="btn btn-primary" title="Send Email">Send Email</button>
            </div>
          </div>
            
          </div>
        </div>
      </div>        
        </form>
      </div>
    </div>
  </div>
</div>

{{ footer }}
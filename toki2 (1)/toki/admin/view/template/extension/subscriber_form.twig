<!-- Modal -->
      <div class="modal-dialog">
          <div class="modal-content">
              <!-- Modal Header -->
            <div class="modal-header">
               <span class="successmessage"></span>
              <div class="tab-first" id="myElemt"></div>
              <button type="button" class="close" data-dismiss="modal">&times;</button>
              <h3 class="modal-title">{{ text_editsubscriber }}</h3>
            </div>
            <!-- Modal body -->
            <div class="modal-body clearfix">
          <form class="form-horizontal" id="formredit" method="post">
            <div class="form-group">
              <label class="control-label col-sm-2" for="input-author">{{ text_name }}</label>
                <div class="col-sm-10" style="padding-top: 9px;"><b>{{ name }}</b>
                </div>
                  <div class="messageerror"></div>
            </div>
            
            <div class="form-group">
              <label class="control-label col-sm-2" for="input-author">{{ text_email }}</label>
                <div class="col-sm-10" style="padding-top: 9px;"><b>{{ email }}  </b>
                </div>
                  <div class="messageerror"></div>
              </div>

              <div class="form-group">
              <label class="control-label col-sm-2" for="input-account">{{ text_acct }}</label>
                <div class="col-sm-10">
                   <select name="account" id="input-account" class="form-control">
                    {% for result in accounts %} 
                    {% if (result['value'] == account) %} 
                    <option value="{{ result['value'] }}" selected="selected">{{ result['name'] }}</option>
                    {% else %} 
                    <option value="{{ result['value'] }}">{{ result['name'] }}</option>
                    {% endif %} 
                    {% endfor %} 
                  </select>
                </div>
              </div>

            <div class="form-group">
              <label class="control-label col-sm-2" for="input-status">{{ text_status }}</label>
                <div class="col-sm-10">
                   <select name="status" id="input-status" class="form-control">
                    {% for result in statuss %} 
                    {% if (result['value'] == status) %} 
                    <option value="{{ result['value'] }}" selected="selected">{{ result['name'] }}</option>
                    {% else %} 
                    <option value="{{ result['value'] }}">{{ result['name'] }}</option>
                    {% endif %} 
                    {% endfor %} 
                  </select>
                </div>
                
              </div>

                 <div class="buttons clearfix">
                 <div class="pull-right">
                    <button id="buttonsave"  type="button" data-toggle="modal" data-target="" class="btn btn-primary">{{ button_save }}</button>
                  </div>
                </div>
            </div>
               </form>
             </div>
           </div>
        </div>




<script>
$('#buttonsave').click(function(){
  var subscriber_id= '{{ subscriberid }}';
  //alert(subscriber_id);
    $.ajax({
      url: 'index.php?route=extension/subscriber/edit&user_token={{ user_token }}&subscriber_id='+subscriber_id,
      type:'post',
      data: $('#formredit input,  #formredit select'),
      dataType:'json',
        beforeSend: function() {
       //$('.modelid').hide();
       $('#buttonsave').button('loading');      
      },
      complete: function() {
        $('#buttonsave').button('reset'); 
      },
      success:function(json) {
         if(json['success']){
         $('.successmessage').html('<div class="alert alert-success">' + json['success'] + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');   
      setTimeout(function(e){ $('.close').trigger('click');location.reload();},2000);
      }
        }    
  
    });
});
</script>
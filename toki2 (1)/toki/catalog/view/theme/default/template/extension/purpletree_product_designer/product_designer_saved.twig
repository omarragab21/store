{{ header }}
<div id="product-product" class="pts-d-container container">
  <ul class="pts-d-breadcrumbfff breadcrumb">
    {% for breadcrumb in breadcrumbs %}
    <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>
     <div style="display:none" class="pts-d-alert pts-d-alert-danger pts-d-alert-dismissible"></div>
	    {% if success %}
    <div class="alert pts-alert-success"><i class="fa fa-check-circle"></i> {{ success }}</div>
    {% endif %}
  <div class="pts-d-row row">{{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6 pts-d-row-col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-sm-9 pts-d-row-col-sm-9' %}
    {% else %}
    {% set class = 'col-sm-12 pts-d-row-col-sm-12' %}
    {% endif %}
    <div id="content" class="{{ class }}">{{ content_top }}
			<h1 class="heading-title">{{ heading_title }}</h1>
      {% if orders %}
   <div class="table-responsive">
          <table class="table table-bordered table-hover list">
            <thead>
            <tr>
              <td class="text-right">{{ id }}</td>
              <td class="text-left">{{ product_name }}</td>
              <td class="text-left">{{ dateadded }}</td>
              <td class="text-left">{{ datemodified }}</td>
              <td class="text-right">{{ action }}</td>
            </tr>
            </thead>
            <tbody>
			{% for item in orders %}
                          <tr>
                <td class="text-right">#{{ item.pdsid }}</td>
                <td class="text-left">{{ item.product_name }}</td>
                <td class="text-left">{{ item.date_modified }}</td>
                <td class="text-left">{{ item.date_added }}</td>
                <td class="text-right"><a href="{{ item.view }}" data-toggle="tooltip" title="" class="btn btn-info btn-primary" data-original-title="View"><i class="fa fa-eye"></i></a>
				<a href="{{ item.delete }}" data-toggle="tooltip" title="" class="btn btn-info btn-primary" data-original-title="Delete"><i class="fa fa-trash"></i></a></td>
              </tr>
			  {% endfor %}
             </tbody>
          </table>
        </div>
      <div class="row">
        <div class="col-sm-6 text-left">{{ pagination }}</div>
        <div class="col-sm-6 text-right">{{ results }}</div>
      </div>
      {% else %}
      <p>{{ text_empty }}</p>
      {% endif %}
      {{ content_bottom }}</div>
    {{ column_right }}</div>
</div>
<style>
.side-column .box-content li a, .side-column .box-category li a {
	background:transparent;
}
<style>
{{ header }}
{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="pts-temp-design-form" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
      <h1>{{ heading_title1 }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
	<div class="container-fluid">
		{% if error_warning %}
		<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
			<button type="button" class="close" data-dismiss="alert">&times;</button>
		</div>
		{% endif %}
		{% if success %}
		<div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ success }}
			<button type="button" class="close" data-dismiss="alert">&times;</button>
		</div>
		{% endif %}
		<div class="panel panel-default card">
			<div class="panel-heading">
				<h3 class="panel-title card-header"><i class="fa fa-credit-card"></i> {{ heading_detailform }}</h3> 
			</div>
			<div class="panel-body card-body">
				<form action="{{ action }}" method="post" enctype="multipart/form-data" id="pts-temp-design-form">
					<input type="hidden" name="template_id" class="form-control" value="{{ template_id }}"/>
					<input type="hidden" name="id" class="form-control" value="{{ id }}"/>
					<input type="hidden" name="product_id" class="form-control" value="{{ product_id }}"/>
					<div class="row">
					<div class="col-sm-12 form-group  row">	
							<div class="col-sm-3">
								<label class="control-label col-form-label">{{ entry_status }}</label>
							</div>
							<div class="col-sm-9">
								<select name="status" id="input-status" class="form-control">
									{% if status %}
									<option value="1" selected="selected">{{ text_enabled }}</option>
									<option value="0">{{ text_disabled }}</option>
									{% else %}
									<option value="1">{{ text_enabled }}</option>
									<option value="0" selected="selected">{{ text_disabled }}</option>
									{% endif %}
								</select>
							</div>
						</div>
				<div class="col-sm-12 form-group  row">
					<div class="col-sm-3">
						<label class="control-label col-form-label">Design Name</label>
					</div>
					<div class="col-sm-9">
						<input type="text" name="template_name" class="form-control" value="{{ template_name }}" id="template_name">
					</div>
				</div>
				<div class="col-sm-12 form-group  row">
					<div class="col-sm-3">
						<label for="template_image" class="control-label col-form-label">Child Product Sample Image</label>
					</div>
					<div class="col-sm-9">
					<a href="" id="thumb-image" data-toggle="image" class="img-thumbnail d-inline-block"><img src="{{ thumb }}" alt="" title="" data-placeholder="{{ placeholder }}" /></a>
						<input type="hidden" name="template_image" value="{{ template_image }}" id="input-template_image" />
					</div>
				</div>
				<div class="col-sm-12 form-group  row">
				<label class="col-sm-3 control-label" for="input-product-design-total-layers">{{ total_layers }}</label>
				<div class="col-sm-9">		
				<input type="text" name="product_designer_total_layers" value="{{ product_designer_total_layers }}" id="input-product-design-total-layers" placeholder="{{ total_layers }}" class="form-control" />				
				</div>
              </div>
				<div class="col-sm-12 form-group  row">
				<label class="col-sm-3 control-label" for="input-product-design-total-text-layers">{{ total_text_layers }}</label>
				<div class="col-sm-9">		
				<input type="text" name="product_designer_total_text_layers" value="{{ product_designer_total_text_layers }}" id="input-product-design-total-text-layers" placeholder="{{ total_text_layers }}" class="form-control" />				
				</div>
              </div>
			  		<div class="col-sm-12 form-group  row">
				<label class="col-sm-3 control-label" for="input-product-design-total-clipart-layers">{{ total_clipart_layers }}</label>
				<div class="col-sm-9">		
				<input type="text" name="product_designer_total_clipart_layers" value="{{ product_designer_total_clipart_layers }}" placeholder="{{ total_layers }}" id="input-product-design-total-clipart-layers" class="form-control" />				
				</div>
              </div>
				<div class="col-sm-12 form-group  row">
				<label class="col-sm-3 control-label" for="input-product-design-total-image-layers">{{ total_image_layers }}</label>
				<div class="col-sm-9">		
				<input type="text" name="product_designer_total_image_layers" value="{{ product_designer_total_image_layers }}" id="input-product-design-total-image-layers" placeholder="{{ total_image_layers }}" class="form-control" />				
				</div>
              </div>
			 	<div class="col-sm-12 form-group  row">
				<label class="col-sm-3 control-label" for="input-product-design-total-icon-layers">{{ total_icon_layers }}</label>
				<div class="col-sm-9">		
				<input type="text" name="product_designer_total_icons_layers" value="{{ product_designer_total_icons_layers }}" id="input-product-design-total-icon-layers" placeholder="{{ total_icon_layers }}" class="form-control" />				
				</div>
              </div>
			  	<div class="col-sm-12 form-group  row">
				<label class="col-sm-3 control-label" for="input-product-design-total-shape-layers">{{ total_shape_layers }}</label>
				<div class="col-sm-9">		
				<input type="text" name="product_designer_total_shapes_layers" value="{{ product_designer_total_shapes_layers }}" id="input-product-design-total-shape-layers" placeholder="{{ total_shape_layers }}" class="form-control" />				
				</div>
              </div>
			  <div class="col-sm-12 form-group  row">	
							<div class="col-sm-3">
								<label class="control-label col-form-label">{{ text_size }}</label>
							</div>
							<div class="col-sm-9">
						<select name="product_designer_canvas_size" id="input-product-design-canvas-size" class="form-control">
						<option value="1" {% if product_designer_canvas_size==1 %}selected="selected"{% endif %}> mm </option>
						<option value="2" {% if product_designer_canvas_size==2 %}selected="selected"{% endif %}> cm </option>
						<option value="3" {% if product_designer_canvas_size==3 %}selected="selected"{% endif %}> foot </option>
						<option value="4" {% if product_designer_canvas_size==4 %}selected="selected"{% endif %}> inches </option>
						</select>
					</div>
				</div>
				<div class="col-sm-12 form-group  row">
				<label class="col-sm-3 control-label" for="input-product-design-total-shape-layers">Sort Order</label>
				<div class="col-sm-9">		
				<input type="text" name="product_designer_sort_order" value="{{ product_designer_sort_order }}" id="input-product-design-sort-order" placeholder="Sort Order" class="form-control" />				
				</div>
              </div>
				<div class="col-sm-12 " style="">
				<table id="design-images" class="table table-striped table-bordered table-hover">
                  <thead>
                    <tr>
                      <td class="text-left">Use Image</td>
                      <td class="text-left" id="ptoduct-design-title">Product Design Image</td>
                      <td class="text-right">Always on Top</td>
                      <td class="text-right"></td>
                      <td class="text-right">Label</td>
					  <td class="text-right">DPI</td>
					  <td class="text-right">Safe Line</td>
					  <td class="text-right">Bleed Size</td>
					  <td class="text-right">Fold Line</td>
                      <td class="text-right">Sort Order</td>
                      <td></td>
                    </tr>
                  </thead>
                  <tbody>
				  {% set entry_create_canvas='Create Design' %}
				{% set image_design_row = 0 %}
                  {% for product_design_image in product_design_images %}
                  <tr id="image-design-row{{ image_design_row }}">
                    <td class="text-left use-img">
						<select id="use-img-{{ image_design_row }}" name="product_design_image[{{ image_design_row }}][use_img]" class="form-control" style="width:70px" pts-data="{{ product_design_image.use_img }}" >
						{% if product_design_image.use_img == 1 %}
						<option value="1" selected="selected">{{ text_yes }} </option>
						<option value="0">{{ text_no }} </option>
							{% else %}
						<option value="1" >{{ text_yes }} </option>
						<option value="0"  selected="selected">{{ text_no }} </option>
							{% endif %}
						</select>
						
					</td>
                    <td colspan="" class="text-left" id="thumb-img-td-{{ image_design_row }}">
					<a href="" pts-data="{{ product_design_image.use_img }}" id="thumb-design-image{{ image_design_row }}" data-toggle="image" class="img-thumbnail" {% if product_design_image.use_img != 1 %} style="display:none" {% endif %} ><img src="{{ product_design_image.thumb }}" alt="" title="" data-placeholder="{{ placeholder }}" /></a>
					
					<img style="display:none" id="thumb-design-thumb{{ image_design_row }}" src="{{ product_design_image.design_thumb }}" />
					
                      <input type="hidden" name="product_design_image[{{ image_design_row }}][image]" value="{{ product_design_image.image }}" id="input-design-image{{ image_design_row }}" />
					  <div class="text-left divheightwidth" id="without-img-td-{{ image_design_row }}" {% if product_design_image.use_img != 0 %} style="display:none" {% endif %} > 
					  <div class="col-sm-9 ">
					  <div class="col-sm-5 ">Width</div>
					  <div class="col-sm-7 "><input type="text" name="product_design_image[{{ image_design_row }}][width]" value="{{ product_design_image.width }}" placeholder="width" class="form-control" /></div>
					  </div>
					  <div class="col-sm-9 ">
					  <div class="col-sm-5 ">Height</div>
					  <div class="col-sm-7 "><input type="text" name="product_design_image[{{ image_design_row }}][height]" value="{{ product_design_image.height }}" placeholder="{{ text_height }}" class="form-control" /></div>
					  </div>					  
					  </div>
					  </td>
					  <td class="text-center">
					  <div id="alwaysontop{{ image_design_row }}" class="ptsalwaysontop" {% if product_design_image.use_img == 0 %} style="display:none" {% endif %}><input style="margin-right: 4px;" id="alwaysontopcheckbox{{ image_design_row }}" type="checkbox" name="product_design_image[{{ image_design_row }}][alwaysontop]" {% if product_design_image.alwaysontop == 1 %} checked="checked" {% endif %} value="{{ product_design_image.alwaysontop }}" /></div>
					  </td>
					  
					  <td class="text-right"><span class="btn btn-primary" id="create-canvas_{{ image_design_row }}"  >{{ entry_create_canvas }}</span>
					 
					  <div id="canvas-area-{{ image_design_row }}">
					  <div>
					  </td>
					  <td class="text-right"><input type="text" name="product_design_image[{{ image_design_row }}][lable]" value="{{ product_design_image.lable }}" placeholder="{{ entry_pts_lable }}" class="form-control" /></td>
					  
					 <td class="text-right"><input type="text" name="product_design_image[{{ image_design_row }}][dpi]" value="{{ product_design_image.dpi }}" placeholder="DPI" class="form-control" /></td>
					 
					 <td class="text-right"><input type="text" name="product_design_image[{{ image_design_row }}][safe_lines]" value="{{ product_design_image.safe_lines }}" placeholder="Safe Lines" class="form-control" /></td>
					 
					 <td class="text-right"><input type="text" name="product_design_image[{{ image_design_row }}][bleed_size]" value="{{ product_design_image.bleed_size }}" placeholder="Bleed Size" class="form-control" /></td>
					 
					 <td class="text-right"><input type="text" name="product_design_image[{{ image_design_row }}][fold_line]" value="{{ product_design_image.fold_line }}" placeholder="Fold Line" class="form-control" /></td>
					  
                    <td class="text-right">
					<input type="text" name="product_design_image[{{ image_design_row }}][sort_order]" value="{{ product_design_image.sort_order }}" placeholder="{{ entry_sort_order }}" class="form-control" />
					
					<input type="hidden" name="product_design_image[{{ image_design_row }}][canvasJsonData]" value="{{ product_design_image.canvasJsonData }}" />
					</td>
                    <td class="text-left"><button type="button" onclick="$('#image-design-row{{ image_design_row }}').remove();" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger"><i class="fa fa-minus-circle"></i></button></td>
                  </tr>
                  {% set image_design_row = image_design_row + 1 %}
                  {% endfor %}
				  </tbody>
                  <tfoot>
                    <tr>
                      <td colspan="10"><strong>Note</strong> - For <strong>Always on Top</strong> checkbox use PNG image with proper transparency for <strong>Product Design Image</strong>. </td>
                      <td class="text-left"><button type="button" onclick="addDesignImage()" data-toggle="tooltip" title="{{ button_image_add }}" class="btn btn-primary"><i class="fa fa-plus-circle"></i></button></td>
                    </tr>
                  </tfoot>
                </table>
				<div>
				 <link href="../catalog/view/theme/default/stylesheet/ptsproductdesign/css/jquery-ui-n.css" rel="stylesheet" />
					</div>
				</form>
			</div>
		</div>
	</div>
</div>

<div class="container no-padding">

    <div class="carousel-cont">
        <div class="haed-item">
            <h2>{{ heading_cross }}</h2>
        </div>


        <div class="swiper-viewport">
            <div id="carousel101{{ module }}" class="swiper-container" dir="{{ direction }}">

                <div class="swiper-wrapper">

                    {% for banner in banners %}
                        <div class="carousel-cont  swiper-slide">
                            {% if banner.link %}
                                <a href="{{ banner.link }}">
                                    <img src="{{ banner.image }}" alt="{{ banner.title }}" class="img-responsive"/>
                                </a>

                            {% else %}
                                <img src="{{ banner.image }}" alt="{{ banner.title }}" class="img-responsive"/>
                            {% endif %}

                        </div>
                    {% endfor %}
                </div>
            </div>

        </div>
    </div>
</div>
<script type="text/javascript"><!--
    $('#carousel101{{ module }}').swiper({
        mode: 'horizontal',
    slidesPerView: 5,
  slidesPerColumn: 2,
    pagination: '.carousel{{ module }}',
    paginationClickable: true,
    nextButton: '.swiper-button-next',
    prevButton: '.swiper-button-prev',
    autoplay: 4500,
    spaceBetween: 30,
    loop: true,
   breakpoints: {
          500: {
            slidesPerView: 2,
            spaceBetween: 20,
            slidesPerColumn: 2,
          },
          768: {
            slidesPerView: 4,
            spaceBetween: 20,
            slidesPerColumn: 2,
          },
          1024: {
            slidesPerView: 5,
            spaceBetween: 20,
          },
        },

    });
    --></script>
                          <label class="btn btn-success md-btn active"><input type="radio" name="status" value="1" checked="checked">{{ text_enabled }}</label>
                          <label class="btn btn-danger md-btn"><input type="radio" name="status" value="0">{{ text_disabled }}</label>
                          {% else %} 
                          <label class="btn btn-success md-btn"><input type="radio" name="status" value="1">{{ text_enabled }}</label>
                          <label class="btn btn-danger md-btn active"><input type="radio" name="status" value="0" checked="checked">{{ text_disabled }}</label>

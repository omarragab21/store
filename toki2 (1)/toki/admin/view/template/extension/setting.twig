{{ header }}{{ column_left }}
<div id="content">
	<div class="page-header">
		<div class="container-fluid">
			<div class="pull-right">
				<button type="button" class="btn btn-info btn-lg" data-toggle="modal" data-target="#myModal">Shortcuts</button>
				<button type="submit" form="form-setting" data-toggle="tooltip" title="{{ button_stay }}" class="btn btn-primary"><i class="fa fa-save"></i> {{ button_stay }}</button>
			</div>
			<h1>{{ heading_title }}</h1>
			<ul class="breadcrumb">
				{% for breadcrumb in breadcrumbs %}
					<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
				{% endfor %}
			</ul>
		</div>
	</div>
	<div class="container-fluid">
		{% if error_warning %}
		<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
			<button type="button" class="close" data-dismiss="alert">&times;</button>
		</div>
		{% endif %}
		<div class="panel panel-default">
			<div class="panel-heading">
				<h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
			</div>
			<div class="panel-body">
				<form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-setting" class="form-horizontal">
					<ul class="nav nav-tabs">
						<li class="active"><a href="#tab-sms" data-toggle="tab">{{ tab_setting }}</a></li>
						<li><a href="#tab-confirmation" data-toggle="tab">{{ tab_registrtion }}</a></li>
						<li><a href="#tab-status" data-toggle="tab">{{ tab_status }}</a></li>
						<li><a href="#tab-affiliate" data-toggle="tab">{{ tab_affiliate }}</a></li>
						<li><a href="#tab-admin" data-toggle="tab">{{ tab_admin }}</a></li>
						<li><a href="#tab-otpverification" data-toggle="tab">{{ tab_otpverification }}</a></li>
						<li><a href="#tab-loginwithotp" data-toggle="tab">{{ tab_loginwithotp }}</a></li>
					</ul>
					<div class="tab-content">
						<div class="tab-pane active" id="tab-sms">
							<fieldset>
							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-ssl">{{ entry_method }}</label>
								<div class="col-sm-10">
									<select name="tmdsms_method" id="input-status" class="form-control">
									{% if tmdsms_method %}
									<option value="1" selected="selected">{{ text_get }}</option>
									<option value="0">{{ text_post }}</option>
									{% else %}
									<option value="1">{{ text_get }}</option>
									<option value="0" selected="selected">{{ text_post }}</option>
									{% endif %}
									</select>
								</div>
							</div>
				  
							<div id="dataget">    
								<div class="form-group">
									<label class="col-sm-2 control-label" for="input-tmdsms_secretkey">{{ entry_key }}</label>
									<div class="col-sm-10">
									   <input type="text" name="tmdsms_key" value="{{ tmdsms_key }}" placeholder="{{ entry_secretkey }}" id="input-tmdsms_secretkey" class="form-control" />
									</div>
								</div>
					
								<div class="form-group">
									<label class="col-sm-2 control-label" for="input-tmdsms_secretkey">{{ entry_secretkey }}</label>
									<div class="col-sm-10">
									   <input type="text" name="tmdsms_secretkey" value="{{ tmdsms_secretkey }}" placeholder="{{ entry_secretkey }}" id="input-tmdsms_secretkey" class="form-control" />
									</div>
								</div> 
					
								<div class="form-group">
									<label class="col-sm-2 control-label" for="input-tmdsms_masterkey">{{ entry_masterkey }}</label>
									<div class="col-sm-10">
									   <input type="text" name="tmdsms_masterkey" value="{{ tmdsms_masterkey }}" placeholder="{{ entry_masterkey }}" id="input-tmdsms_masterkey" class="form-control" />
									</div>
								</div> 
							</div>
							<fieldset id="datapost">   
								<div class="form-group">
									<label class="col-sm-2 control-label" for="input-tmdsms_url">{{ entry_url }}</label>
									<div class="col-sm-10">
										<textarea name="tmdsms_url" rows="5" placeholder="{{ entry_url }}" id="input-tmdsms_url" class="form-control">{{ tmdsms_url }}</textarea>
									</div>
								</div> 
							</fieldset>
							
							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-telephone">{{ entry_telephone }}</label>
								<div class="col-sm-10">
									<input type="number" name="tmdsms_telephone" placeholder="{{ entry_telephone }}" value="{{ tmdsms_telephone }}" id="input-tmdsms_telephone" class="form-control">
								</div>
							</div> 

							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-debug">{{ entry_debug }}</label>
								<div class="col-sm-10">
									<select name="tmdsms_debug" id="input-debug" class="form-control">
										{% if tmdsms_debug %}
										<option value="1" selected="selected">{{ text_yes }}</option>
										<option value="0">{{ text_no }}</option>
										{% else %}
										<option value="1">{{ text_yes }}</option>
										<option value="0" selected="selected">{{ text_no }}</option>
										{% endif %}
									</select>
								</div>
							</div>
				  
							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-ssl">{{ entry_ssl }}</label>
								<div class="col-sm-10">
									<select name="tmdsms_ssl" id="input-status" class="form-control">
									{% if tmdsms_ssl %}
									<option value="1" selected="selected">{{ text_yes }}</option>
									<option value="0">{{ text_no }}</option>
									{% else %}
									<option value="1">{{ text_yes }}</option>
									<option value="0" selected="selected">{{ text_no }}</option>
									{% endif %}
									</select>
								</div>
							</div>
               
							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
								<div class="col-sm-10">
									<select name="tmdsms_status" id="input-status" class="form-control">
									{% if tmdsms_status %}
									<option value="1" selected="selected">{{ text_enabled }}</option>
									<option value="0">{{ text_disabled }}</option>
									{% else %}
									<option value="1">{{ text_enabled }}</option>
									<option value="0" selected="selected">{{ text_disabled }}</option>
									{% endif %}
									</select>
								</div>
							</div>
							</fieldset>
						</div>
						
						<div class="tab-pane" id="tab-confirmation">
							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-tmdsms_registrtion_approval">{{ entry_registrtion }}</label>
								<div class="col-sm-10">
									<textarea name="tmdsms_registrtion_approval" rows="5" placeholder="Registrtion Message" id="input-tmdsms_registrtion_approval" class="form-control">{{ tmdsms_registrtion_approval }}</textarea>
								</div>
								<label class="col-sm-2 control-label" for="input-tmdsms_dltid">{{ entry_dltid }}</label>
								<div class="col-sm-10">
									<input type="text" name="tmdsms_registrtion_approval_dltid" placeholder="{{ entry_dltid }}" value="{{ tmdsms_registrtion_approval_dltid }}" id="input-tmdsms_dltid" class="form-control">
								</div>
							</div> 
				
							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-tmdsms_registrtion_disapproval">{{ entry_registrtiondis }}</label>
								<div class="col-sm-10">
									<textarea name="tmdsms_registrtion_disapproval" rows="5" placeholder="Registrtion Message" id="input-tmdsms_registrtion_disapproval" class="form-control">{{ tmdsms_registrtion_disapproval }}</textarea>
								</div>
								<label class="col-sm-2 control-label" for="input-tmdsms_dltid">{{ entry_dltid }}</label>
								<div class="col-sm-10">
									<input type="text" name="tmdsms_registrtion_disapproval_dltid" placeholder="{{ entry_dltid }}" value="{{ tmdsms_registrtion_disapproval_dltid }}" id="input-tmdsms_dltid" class="form-control">
								</div>
							</div>
				
							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-tmdsms_forgotpassword_sms">{{ entry_forgot_password }}</label>
								<div class="col-sm-10">
									<textarea name="tmdsms_forgotpassword_sms" rows="5" placeholder="Forgot Password" id="input-tmdsms_forgotpassword_sms" class="form-control">{{ tmdsms_forgotpassword_sms }}</textarea>
								</div>
								<label class="col-sm-2 control-label" for="input-tmdsms_dltid">{{ entry_dltid }}</label>
								<div class="col-sm-10">
									<input type="text" name="tmdsms_forgotpassword_dltid" placeholder="{{ entry_dltid }}" value="{{ tmdsms_forgotpassword_dltid }}" id="input-tmdsms_dltid" class="form-control">
								</div>
							</div>
						</div>

						<div class="tab-pane" id="tab-status">
							{% for order_status in order_statuses %}
							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-tmdsms_orderstatus">{{ order_status.name }}</label>
								<div class="col-sm-10">
									<textarea name="tmdsms_orderstatus[{{ order_status.order_status_id }}][name]" rows="4" placeholder="" id="input-tmdsms_orderstatus" class="form-control">{{ tmdsms_orderstatus[order_status.order_status_id] ? tmdsms_orderstatus[order_status.order_status_id].name }}</textarea>
								</div>
								<label class="col-sm-2 control-label" for="input-tmdsms_dltid">{{ entry_dltid }}</label>
								<div class="col-sm-10">
									<input type="text" name="tmdsms_orderstatus[{{ order_status.order_status_id }}][dltid]" placeholder="{{ entry_dltid }}" value="{{ tmdsms_orderstatus[order_status.order_status_id] ? tmdsms_orderstatus[order_status.order_status_id].dltid }}" id="input-tmdsms_dltid" class="form-control">
								</div>
							</div>
							{% endfor %}
						</div>

						<div class="tab-pane" id="tab-affiliate">   
							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-tmdsms_affiliate_approval">{{ entry_affiliate_approval }}</label>
								<div class="col-sm-10">
									<textarea name="tmdsms_affiliate_approval" rows="5" placeholder="{{ entry_affiliate_approval }}" id="input-tmdsms_affiliate_approval" class="form-control">{{ tmdsms_affiliate_approval }}</textarea>
								</div>
								<label class="col-sm-2 control-label" for="input-tmdsms_dltid">{{ entry_dltid }}</label>
								<div class="col-sm-10">
									<input type="text" name="tmdsms_affiliate_approval_dltid" placeholder="{{ entry_dltid }}" value="{{ tmdsms_affiliate_approval_dltid }}" id="input-tmdsms_dltid" class="form-control">
								</div>
							</div>
				
							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-tmdsms_affiliate_disapproval">{{ entry_affiliate_disapproval }}</label>
								<div class="col-sm-10">
									<textarea name="tmdsms_affiliate_disapproval" rows="5" placeholder="{{ entry_affiliate_disapproval }}" id="input-tmdsms_affiliate_disapproval" class="form-control">{{ tmdsms_affiliate_disapproval }}</textarea>
								</div>
								<label class="col-sm-2 control-label" for="input-tmdsms_dltid">{{ entry_dltid }}</label>
								<div class="col-sm-10">
									<input type="text" name="tmdsms_affiliate_disapproval_dltid" placeholder="{{ entry_dltid }}" value="{{ tmdsms_affiliate_disapproval_dltid }}" id="input-tmdsms_dltid" class="form-control">
								</div>
							</div>
				
							<div class="form-group">
							  <label class="col-sm-2 control-label" for="input-tmdsms_forgotpassword_affiliate">{{ entry_forgot_password }}</label>
							  <div class="col-sm-10">
								<textarea name="tmdsms_forgotpassword_affiliate" rows="5" placeholder="{{ entry_forgot_password }}" id="input-tmdsms_forgotpassword_affiliate" class="form-control">{{ tmdsms_forgotpassword_affiliate }}</textarea>
							  </div>
								<label class="col-sm-2 control-label" for="input-tmdsms_dltid">{{ entry_dltid }}</label>
								<div class="col-sm-10">
									<input type="text" name="tmdsms_forgotpassword_affiliate_dltid" placeholder="{{ entry_dltid }}" value="{{ tmdsms_forgotpassword_affiliate_dltid }}" id="input-tmdsms_dltid" class="form-control">
								</div>
							</div>
						</div>

						<div class="tab-pane" id="tab-admin">   
							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-tmdsms_admin_order">{{ entry_order }}</label>
								<div class="col-sm-10">
									<textarea name="tmdsms_admin_order" rows="5" placeholder="{{ entry_order }}" id="input-tmdsms_admin_order" class="form-control">{{ tmdsms_admin_order }}</textarea>
								</div>
								<label class="col-sm-2 control-label" for="input-tmdsms_dltid">{{ entry_dltid }}</label>
								<div class="col-sm-10">
									<input type="text" name="tmdsms_admin_order_dltid" placeholder="{{ entry_dltid }}" value="{{ tmdsms_admin_order_dltid }}" id="input-tmdsms_dltid" class="form-control">
								</div>
							</div>

							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-tmdsms_admin_customer">{{ entry_customer }}</label>
								<div class="col-sm-10">
									<textarea name="tmdsms_admin_customer" rows="5" placeholder="{{ entry_customer }}" id="input-tmdsms_admin_customer" class="form-control">{{ tmdsms_admin_customer }}</textarea>
								</div>
								<label class="col-sm-2 control-label" for="input-tmdsms_dltid">{{ entry_dltid }}</label>
								<div class="col-sm-10">
									<input type="text" name="tmdsms_admin_customer_dltid" placeholder="{{ entry_dltid }}" value="{{ tmdsms_admin_customer_dltid }}" id="input-tmdsms_dltid" class="form-control">
								</div>
							</div>

							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-tmdsms_admin_affiliate">{{ entry_adminaffiliate }}</label>
								<div class="col-sm-10">
									<textarea name="tmdsms_admin_affiliate" rows="5" placeholder="{{ entry_adminaffiliate }}" id="input-tmdsms_admin_affiliate" class="form-control">{{ tmdsms_admin_affiliate }}</textarea>
								</div>
								<label class="col-sm-2 control-label" for="input-tmdsms_dltid">{{ entry_dltid }}</label>
								<div class="col-sm-10">
									<input type="text" name="tmdsms_admin_affiliate_dltid" placeholder="{{ entry_dltid }}" value="{{ tmdsms_admin_affiliate_dltid }}" id="input-tmdsms_dltid" class="form-control">
								</div>
							</div>
						</div>

						<div class="tab-pane" id="tab-otpverification">   
							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-tmdsms_otpverifystatus">{{ entry_otpverification }}</label>
								<div class="col-sm-10">
									<select name="tmdsms_otpverifystatus" id="input-tmdsms_otpverifystatus" class="form-control">
										{% if tmdsms_otpverifystatus %}
										<option value="1" selected="selected">{{ text_enabled }}</option>
										<option value="0">{{ text_disabled }}</option>
										{% else %}
										<option value="1">{{ text_enabled }}</option>
										<option value="0" selected="selected">{{ text_disabled }}</option>
										{% endif %}
									</select>
								</div>
							</div>

							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-tmdsms_otpmsg">{{ entry_otpmsg }}</label>
								<div class="col-sm-10">
									<textarea name="tmdsms_otpmsg" rows="5" placeholder="{{ entry_adminaffiliate }}" id="input-tmdsms_otpmsg" class="form-control">{{ tmdsms_otpmsg }}</textarea>
								</div>
								<label class="col-sm-2 control-label" for="input-tmdsms_dltid">{{ entry_dltid }}</label>
								<div class="col-sm-10">
									<input type="text" name="tmdsms_otpmsg_dltid" placeholder="{{ entry_dltid }}" value="{{ tmdsms_otpmsg_dltid }}" id="input-tmdsms_dltid" class="form-control">
								</div>
							</div>

							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-tmdsms_verifypage">{{ entry_verifypage }}</label>
								<div class="col-sm-10">
									{% for language in languages %}
									<div class="input-group"><span class="input-group-addon"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" /></span>
										<input name="tmdsms_otpverify[{{ language.language_id }}][verifypage]" placeholder="{{ entry_verifypage }}" value="{{ tmdsms_otpverify[language.language_id] ? tmdsms_otpverify[language.language_id].verifypage }}" class="form-control"/>
									</div>
									{% endfor %}
								</div>
							</div>

							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-mygdpr-title">{{ entry_title }}</label>
								<div class="col-sm-10">
									{% for language in languages %}
									<div class="input-group"><span class="input-group-addon"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" /></span>
										<input name="tmdsms_otpverify[{{ language.language_id }}][title]" placeholder="{{ entry_title }}" value="{{ tmdsms_otpverify[language.language_id] ? tmdsms_otpverify[language.language_id].title }}" class="form-control"/>
									</div>
									{% endfor %}
								</div>
							</div>

							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-mygdpr-title">{{ entry_descriptiontop }}</label>
								<div class="col-sm-10">
									{% for language in languages %}
									<div class="input-group"><span class="input-group-addon"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" /></span>
										<textarea name="tmdsms_otpverify[{{ language.language_id }}][descriptiontop]"  data-toggle="summernote" data-lang="{{ summernote }}" placeholder="{{ entry_descriptiontop }}" value="" class="form-control">{{ tmdsms_otpverify[language.language_id] ? tmdsms_otpverify[language.language_id].descriptiontop }}</textarea>
									</div>
									{% endfor %}
								</div>
							</div>

							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-mygdpr-title">{{ entry_descriptionbottom }}</label>
								<div class="col-sm-10">
									{% for language in languages %}
									<div class="input-group"><span class="input-group-addon"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" /></span>
										<textarea name="tmdsms_otpverify[{{ language.language_id }}][descriptionbottom]"  data-toggle="summernote" data-lang="{{ summernote }}" placeholder="{{ entry_descriptionbottom }}" value="" class="form-control"/>{{ tmdsms_otpverify[language.language_id] ? tmdsms_otpverify[language.language_id].descriptionbottom }}</textarea>
									</div>
									{% endfor %}
								</div>
							</div>

							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-mygdpr-title">{{ entry_labelotp }}</label>
								<div class="col-sm-10">
									{% for language in languages %}
									<div class="input-group"><span class="input-group-addon"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" /></span>
										<input name="tmdsms_otpverify[{{ language.language_id }}][labelotp]" placeholder="{{ entry_labelotp }}" value="{{ tmdsms_otpverify[language.language_id] ? tmdsms_otpverify[language.language_id].labelotp }}" class="form-control"/>
									</div>
									{% endfor %}
								</div>
							</div>

							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-mygdpr-title">{{ entry_btnverify }}</label>
								<div class="col-sm-10">
									{% for language in languages %}
									<div class="input-group"><span class="input-group-addon"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" /></span>
										<input name="tmdsms_otpverify[{{ language.language_id }}][btnverify]" placeholder="{{ entry_btnverify }}" value="{{ tmdsms_otpverify[language.language_id] ? tmdsms_otpverify[language.language_id].btnverify }}" class="form-control"/>
									</div>
									{% endfor %}
								</div>
							</div>

							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-mygdpr-title">{{ entry_resend }}</label>
								<div class="col-sm-10">
									{% for language in languages %}
									<div class="input-group"><span class="input-group-addon"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" /></span>
										<input name="tmdsms_otpverify[{{ language.language_id }}][resendbtn]" placeholder="{{ entry_resend }}" value="{{ tmdsms_otpverify[language.language_id] ? tmdsms_otpverify[language.language_id].resendbtn }}" class="form-control"/>
									</div>
									{% endfor %}
								</div>
							</div>
						</div>

						<div class="tab-pane" id="tab-loginwithotp">  
							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-tmdsms_loginbtnstatus">{{ entry_loginbtnstatus }}</label>
								<div class="col-sm-10">
									<select name="tmdsms_loginbtnstatus" id="input-tmdsms_loginbtnstatus" class="form-control">
									{% if tmdsms_loginbtnstatus %}
									<option value="1" selected="selected">{{ text_enabled }}</option>
									<option value="0">{{ text_disabled }}</option>
									{% else %}
									<option value="1">{{ text_enabled }}</option>
									<option value="0" selected="selected">{{ text_disabled }}</option>
									{% endif %}
									</select>
								</div>
							</div>

							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-tmdsms_otpmsg">{{ entry_otpmsg }}</label>
								<div class="col-sm-10">
									<textarea name="tmdsms_loginotpmsg" rows="5" placeholder="{{ entry_adminaffiliate }}" id="input-tmdsms_otpmsg" class="form-control">{{ tmdsms_loginotpmsg }}</textarea>
								</div>
								<label class="col-sm-2 control-label" for="input-tmdsms_dltid">{{ entry_dltid }}</label>
								<div class="col-sm-10">

<style>
{% if (pqv_loader_bg_color) %} 
.pqv-loader {
  background-color: {{ pqv_loader_bg_color }};
}
{% endif %} 

{% if (pqv_loader_font_color) %} 
.pqv-loader {
  color: {{ pqv_loader_font_color }};
}
{% endif %} 

{% if (pqv_show_on_mobile) %} 
@media (max-width: 991px) {
  .btn-quick-view {
    display: block;
  }
}
{% endif %} 

{% if (pqv_btn_quick_view_size and pqv_btn_quick_view_font_size) %} 
@media (min-width: 992px) {
  .btn-quick-view {
    height:{{ pqv_btn_quick_view_size }}px;
    width:{{ pqv_btn_quick_view_size }}px;
    line-height:{{ pqv_btn_quick_view_size }}px;
    font-size:{{ pqv_btn_quick_view_font_size }}px;
  }

  .btn-quick-view i {
    font-size:{{ pqv_btn_quick_view_font_size }}px;
  }
}
{% endif %} 

{% if (pqv_btn_quick_view_bg_color) %} 
.btn-quick-view {
  background: {{ pqv_btn_quick_view_bg_color }};
}
{% endif %} 

{% if (pqv_btn_quick_view_opacity and pqv_btn_quick_view_opacity_ie) %} 
.btn-quick-view {
  opacity: {{ pqv_btn_quick_view_opacity }};
  -ms-filter: "progid:DXImageTransform.Microsoft.Alpha(Opacity={{ pqv_btn_quick_view_opacity_ie }})";
  filter: alpha(opacity={{ pqv_btn_quick_view_opacity_ie }});
}
{% endif %} 

{% if (pqv_btn_quick_view_font_color) %} 
.btn-quick-view {
  color: {{ pqv_btn_quick_view_font_color }};
}
{% endif %} 

{% if (pqv_popup_bg_color) %} 
#product_quick_view .modal-content {
  background-color:{{ pqv_popup_bg_color }};
}
{% endif %} 

{% if (pqv_popup_width) %} 
.pqv-modal {
  max-width: {{ pqv_popup_width }}px;
}
{% endif %} 

{% if (pqv_popup_border_radius or pqv_popup_border_radius == '0') %} 
#product_quick_view .modal-content {
  border-radius:{{ pqv_popup_border_radius }}px;
}
{% endif %} 

{% if (pqv_plain_text_color) %} 
#product_quick_view .modal-content {
  color:{{ pqv_plain_text_color }};
}

#product_quick_view h2,
#product_quick_view h3,
#product_quick_view h4,
#product_quick_view .price,
#product_quick_view .price-tax {
  color:{{ pqv_plain_text_color }};
}
{% endif %} 

{% if (pqv_link_color) %} 
#product_quick_view a:not(.btn) {
  color:{{ pqv_link_color }};
}
{% endif %} 

{% if (pqv_image_border_size) %} 
.pqv-image-block,
#product_quick_view .thumbnail {
  border-width: {{ pqv_image_border_size }}px
}
{% endif %} 

{% if (pqv_image_border_color) %} 
.pqv-image-block,
#product_quick_view .thumbnail {
  border-color: {{ pqv_image_border_color }};
}
#product_quick_view .thumbnail:hover {
  box-shadow: inset 0 0 1px rgba(0, 0, 0, 0.4);
}
{% endif %} 

{% if (pqv_image_border_radius or pqv_image_border_radius == '0') %} 
.pqv-image-block,
#product_quick_view .thumbnail {
  border-radius:{{ pqv_image_border_radius }}px;
}
{% endif %} 

{% if (pqv_buttons_bg_color) %} 
#product_quick_view .btn-primary {
  background-color:{{ pqv_buttons_bg_color }};
  border-color:{{ pqv_buttons_bg_color }};
  background-image:none;
  outline-style:none;
  border-radius:{{ pqv_btn_border_radius }}px;
}
#product_quick_view .btn-primary:hover {
  box-shadow:inset 0 100px 0 rgba(0, 0, 0, 0.1);
}
#product_quick_view .btn-primary:active {
  box-shadow:inset 0 100px 0 rgba(0, 0, 0, 0.2);
}
{% endif %} 

{% if (pqv_buttons_font_color) %} 
#product_quick_view .btn-primary {
  color:{{ pqv_buttons_font_color }};
}
{% endif %} 

{% if (pqv_button_default_bg_color) %} 
#product_quick_view .btn-default {
  background-color:{{ pqv_button_default_bg_color }};
  border-color:{{ pqv_button_default_bg_color }};
  background-image:none;
  outline-style:none;
  text-shadow:none;
}
#product_quick_view .btn-default:hover {
  box-shadow:inset 0 100px 0 rgba(0, 0, 0, 0.1);
}
#product_quick_view .btn-default:active {
  box-shadow:inset 0 100px 0 rgba(0, 0, 0, 0.2);
}
#product_quick_view .btn-group>.btn:last-child:not(:first-child) {
  border-left: solid 1px rgba(200,200,200, 0.7);
}
{% endif %} 

{% if (pqv_button_default_font_color) %} 
#product_quick_view .btn-default {
  color:{{ pqv_button_default_font_color }};
}
{% endif %} 

{% if (pqv_btn_in_cart_bg_color) %} 
#product_quick_view #pqv-button-cart.pqv-btn-in-cart {
  background-color:{{ pqv_btn_in_cart_bg_color }};
  border-color:{{ pqv_btn_in_cart_bg_color }};
  background-image:none;
  outline-style:none;
}
#product_quick_view #pqv-button-cart.pqv-btn-in-cart:hover {
  box-shadow:inset 0 100px 0 rgba(0, 0, 0, 0.1);
}
#product_quick_view #pqv-button-cart.pqv-btn-in-cart:active {
  box-shadow:inset 0 100px 0 rgba(0, 0, 0, 0.2);
}
{% endif %} 

{% if (pqv_btn_in_cart_font_color) %} 
#product_quick_view #pqv-button-cart.pqv-btn-in-cart {
  color:{{ pqv_btn_in_cart_font_color }};
}
{% endif %} 

{% if (pqv_btn_border_radius or pqv_btn_border_radius == '0') %} 
#product_quick_view .btn-primary,
#product_quick_view .btn-default,
#product_quick_view textarea.form-control,
#product_quick_view .form-control:first-child,
#product_quick_view .form-control:last-child {
  border-radius:{{ pqv_btn_border_radius }}px;
}

#product_quick_view .input-group .form-control:first-child,
#product_quick_view .input-group-addon:first-child,
#product_quick_view .input-group-btn:first-child>.btn,
#product_quick_view .input-group-btn:first-child>.btn-group>.btn,
#product_quick_view .input-group-btn:last-child>.btn-group:not(:last-child)>.btn,
#product_quick_view .input-group-btn:last-child>.btn:not(:last-child):not(.dropdown-toggle) {
  border-top-right-radius:0;
  border-bottom-right-radius:0;
}

#product_quick_view .input-group .form-control:last-child,
#product_quick_view .input-group-addon:last-child,
#product_quick_view .input-group-btn:first-child>.btn-group:not(:first-child)>.btn,
#product_quick_view .input-group-btn:first-child>.btn:not(:first-child),
#product_quick_view .input-group-btn:last-child>.btn,
#product_quick_view .input-group-btn:last-child>.btn-group>.btn {
  border-top-left-radius:0;
  border-bottom-left-radius:0;
}

#product_quick_view .pqv-alert-inner {
  border-radius: {{ pqv_btn_border_radius }}px;
}

#product_quick_view .btn-group>.btn:last-child:not(:first-child) {
  border-top-left-radius: 0;
  border-bottom-left-radius: 0;
}
#product_quick_view .btn-group>.btn:first-child:not(:last-child):not(.dropdown-toggle) {
  border-top-right-radius: 0;
  border-bottom-right-radius: 0;
}
{% endif %} 

{{ pqv_custom_css }} 
</style>

<script>
window.productQuickView = {
  text_quick_view: '{{ pqv_text_quick_view }}',
  btn_in_cart: '{{ pqv_btn_in_cart }}',
  text_loading: '{{ text_loading }}',
  show_button: {{ pqv_show_button }},
  click_on_image: {{ pqv_click_on_image }},
  click_on_link: {{ pqv_click_on_link }},
  replace_button: {{ pqv_replace_button }},
};
</script>

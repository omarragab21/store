{{ header }} 
<div class="container">
  <div class="verify-success"></div>
  <div class="row">
  <div class="col-sm-12 text-center">
    {% if (verify_logostatus == 1) %}
      <img src="{{ logo }}" title="" class="img-thumbnail">
    {% endif %} 
    {% if (verify_titlestatus == 1) %}
    <h2>{{ newsletter_verifytitle_text }}</h2>
    {% endif %}
           <form action="" method="post" enctype="multipart/form-data" class="form-horizontal">
          <div id="addsubs">
            {% if (verify_descstatus == 1) %}
                <h4>{{ newsletter_verifydesc_text }}</h4>
            {% endif %} 
            <div class="buttons clearfix">
                <input type="button" value="{{ newsletter_confirmbtn_text }}" class="btn btn-primary" id="newsletter-verify" />

              {% if (verify_declinebtn == 1) %}
                <input type="button" value="{{ newsletter_declinebtn_text }}" class="btn btn-danger" id="newsletter-decline"/>
            {% endif %} 
            
            </div>

            </div>
     </form>
    </div>
  </div>
</div>



<script>
$('#newsletter-verify').click(function(){

  var successtext= '{{ newsletter_verifysuccessmsg_text }}';
  var errrormsgtext= '{{ newsletter_invalidmessage_text }}';
  var code= '{{ code }}';
    $.ajax({
        url:'index.php?route=extension/newsletterverify/addverifynewsletter&code='+code,
        type: 'post',
        data:$('#addsubs input[type=\'text\']'),
        dataType: 'json',
        beforeSend: function() {
          $('#newsletter-verify').button('loading');
        },
    complete: function() {
   $('#newsletter-verify').button('reset');
    },
        success: function(json) {
        if(json['error']){ 
        $('.verify-success').html('<div class="alert alert-danger">' + errrormsgtext + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');       
        
        }


      if (json['success']) {    
       // $('.alert-success').fadeOut(1000);
       location.reload();
      }
  
        }
    });
 });
</script>

<script>
$('#newsletter-decline').click(function(){
  var successtext= '{{ newsletter_declinesuccessmsg_text }}';
    var errrormsgtext= '{{ newsletter_invalidmessage_text }}';
    var code= '{{ code }}';
    $.ajax({
        url:'index.php?route=extension/newsletterverify/adddeclinenewsletter&code='+code,
        type: 'post',
        data:$('#addsubs input[type=\'text\']'),
        dataType: 'json',
        beforeSend: function() {
          $('#newsletter-decline').button('loading');
        },
    complete: function() {
   $('#newsletter-decline').button('reset');
    },
        success: function(json) {
          if(json['error']){ 
        $('.verify-success').html('<div class="alert alert-danger">' + errrormsgtext + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');       
        
        }

      if (json['success']) {    
       ///$('.alert-success').fadeOut(4000);
       location.reload();

      }
  
        }
    });
 });
</script>
{{ footer }} 

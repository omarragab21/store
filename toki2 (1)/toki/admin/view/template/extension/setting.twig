<script type="text/javascript"><!--
  $('select[name=\'tmdsms_method\']').on('change', function() {
    if (this.value == '1') {
      $('#datapost').show();
      $('#dataget').hide();
    } else if(this.value == '0'){
      $('#datapost').hide();
      $('#dataget').show();
    }
  });

  $('select[name=\'tmdsms_method\']').trigger('change');
</script>

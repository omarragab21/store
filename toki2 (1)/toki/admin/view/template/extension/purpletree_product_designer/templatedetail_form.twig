$(document).on('change','.use-img',function(e){
	var use_img_id=e.target.id;
	var use_img_row=use_img_id.split('-');
	var use_img_row_id=use_img_row[2];
	var use_img_val=$('#'+use_img_id).val();
	var placeholder='{{ placeholder }}';
	if(use_img_val=='1'){
		$('#without-img-td-'+use_img_row_id).css('display','none');
		$('#thumb-design-image'+use_img_row_id).css('display','block');
		$('#alwaysontop'+use_img_row_id).css('display','block');
	} else if (use_img_val=='0') {
		$('#thumb-design-image'+use_img_row_id).css('display','none');
		$('#alwaysontop'+use_img_row_id).css('display','none');
		$('#without-img-td-'+use_img_row_id).css('display','block');
	}
	});
	
$(document).on('dblclick','.pts-upper',function(e){
		var pts_uni=$(this).children('span').text();
		var pts_unicode=String.fromCharCode(parseInt(pts_uni,16));
		var pts_fa_class=$(this).children('.pts-unicode').text();
		$('#pts-layer-icons').modal('hide');
	});
	
$(document).on('click','.pts-upper',function(e){
		var icon_id= $(this).attr('id');
		$('#'+icon_id).removeClass('off');
		$('#'+icon_id).removeClass('on');
		$('#'+icon_id).addClass('on');
		$('.pts-upper').not('#'+icon_id).removeClass('on');
		$('.pts-upper').not('#'+icon_id).addClass('off');
	});
	function vewProductImage1(e){
				var row_id = e.parentNode.parentNode.id;
								
				var base_path='';
				if($('#'+row_id+' td input[id^=input-design-image]').val()){					
					$('#can_field div').remove();
				$("#view_design_image").modal("show");
					$('[id^=image-design-]').removeClass('popup-on');
					$('#'+row_id).addClass('popup-on');
				base_path="{{ DESIGN_IMAGE_ROOT }}"+$('#'+row_id+' td input[id^=input-design-image]').val();
				$('#'+row_id+' td img[id^=thumb-design-thumb]').attr('src',base_path);
				$('#view_img').attr('src',base_path);

			setTimeout(function(){
			
			var canRowId= row_id.replace("image-design-row", "");
			var safe_lines=$('input[name="product_design_image[0][safe_lines]"]').val();
			var safe_lines_px=safe_lines+'px';
			$('#can_field').css('margin',safe_lines_px);
			$('#can_field').css('width','530px');			 
		 $("[id^='id-canvas-area-"+canRowId+"-']").each(function(ind1,results){
		 
				let inData= results.id.split('-');
				canvasType=inData[4];
				index=inData[5];
				canvasVal=results.value;				
				 var canTextDiv = document.createElement('div');
				 canTextDiv.id = 'can_'+canvasType+'_div_'+index;
				 $("#can_field").append(canTextDiv);
				 var mar_left=(550-($("#view_img").width()))/2;
				 
				var canvasArea=canvasVal.split(",");
				var cnvas_left=parseInt(canvasArea[0])+'px';
				var cnvas_top=parseInt(canvasArea[1])+'px';
				var cnvas_width=parseInt(canvasArea[2])+'px';
				var cnvas_heigth=parseInt(canvasArea[3])+'px';
				
				var cnvasLeft=parseFloat(mar_left)+parseFloat(cnvas_left);
				$( "#can_"+canvasType+"_div_"+index ).css('left',cnvasLeft);	
				$( "#can_"+canvasType+"_div_"+index ).css('top',cnvas_top);	
				$( "#can_"+canvasType+"_div_"+index ).css('width',cnvas_width);	

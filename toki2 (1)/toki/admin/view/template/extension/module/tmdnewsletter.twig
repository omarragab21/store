<script type="text/javascript"><!--
var unsbscribe_row = {{ unsbscribe_row }};

function unsubscribeRow() {
  html  = '<tr id="unsbscribe-row' + unsbscribe_row + '">'; 
    html += '  <td class="text-left" style="width: 70%;">';
  {% for language in languages %} 
  html += '  <div class="input-group">';
  html += '    <span class="input-group-addon"><img src="language/{{ language['code'] }}/{{ language['code'] }}.png" title="{{ language['name'] }}" /></span><input type="text" name="tmdnewsletter_unsbscribe_reason[' + unsbscribe_row + '][description][{{ language['language_id'] }}][title]" value="" placeholder="{{ entry_name }}" class="form-control" />';
    html += '  </div>';
  {% endfor %} 
  html += '  </td>';



  html += '  <td class="text-left"><button type="button" onclick="$(\'#unsbscribe-row' + unsbscribe_row + '\').remove();" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger"><i class="fa fa-minus-circle"></i></button></td>';
  
  html += '</tr>';  
  
  $('#filter tbody').append(html);
  
  unsbscribe_row++;
}
//--></script>


  <script type="text/javascript"><!--
$('#button-filter').on('click', function() {

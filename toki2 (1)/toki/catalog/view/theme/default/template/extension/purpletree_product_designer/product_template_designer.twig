async function uploadImage(input) {
return new Promise((resolve, reject) => {
	var dataReturn={};
  if (input.files && input.files[0]) {
	  file = input.files[0];
    var reader = new FileReader();
		reader.fileName = file.name;
	reader.onprogress = function(event) {
		 $('.thumbnails').addClass('overlay');
		 $('#pts_loader').css('display','block');
	};
	//reader.onloadend = function(event) {
		//setTimeout(function(){
			//$('.thumbnails').removeClass('overlay');
			//$('#pts_loader').css('display','none');
			//},100);
	//};
	
    reader.onload = function(e) {
		var imageurl=e.target.result;
		var formData = new FormData();
		formData.append("uploadfile", imageurl);  
		dataReturn.fileName=e.target.fileName;
		 $.ajax({
				type: 'POST',
				url: 'index.php?route=extension/purpletree_product_designer/product_template_designer/uploadImage',
				cache: false,
				contentType: false,
				processData: false,
				data: formData,
				dataType: 'json',
				beforeSend: function( xhr ) {
				  },
				success: function(jsonData) {
					setTimeout(function(){ 
				$('.thumbnails').removeClass('overlay');
			$('#pts_loader').css('display','none');
			},8005);
					dataReturn.url=jsonData.url;
					console.log(dataReturn);
					resolve(dataReturn);
			 },
			error: function(xhr, ajaxOptions, thrownError) {
			setTimeout(function(){ 
			$('.thumbnails').removeClass('overlay');
			$('#pts_loader').css('display','none');
			},4000);					
			//$('.fixedwidth550').css('visibility','visible');
				//zoomthecanvas();
				alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
			}
		});	
	}
	 reader.readAsDataURL(input.files[0]);
  }
});
}

<script type="text/javascript">
var xtensions_module = '{{ xtensions_module }}';
var image_row = {{ image_row }};

function addImage() {
	html  = '<div class="footerImage" id="footerImage' + image_row + '">';
	html += '<a href="" id="thumb-image' + image_row + '"data-toggle="image" class="img-thumbnail"><img width="50" src="{{ placeholder }}" alt="" title="" data-placeholder="{{ placeholder }}" /></a><input type="hidden" name="options[footer][images][]" value="" id="input-image' + image_row + '" />';
	html += '<i onclick="$(\'#footerImage' + image_row  + '\').remove();" data-toggle="tooltip" title="{{ button_remove }}" class="fa fa-times removeimage"></i>';
	html += '</div>';
	$('#images #addFooterImage').before(html);

	image_row++;
}
$('select[name=\'store_id\']').bind('change', function() {
	location = 'index.php?route={{ xtensions_admin_xcheckout_path }}&user_token={{ user_token }}&store_id=' + this.value;
});
$('select[name=\'options[country_id]\']').bind('change', function() {
  $.ajax({
    url: 'index.php?route={{ xtensions_admin_xcheckout_path }}/country&user_token={{ user_token }}&country_id=' + this.value,
    dataType: 'json',          
    success: function(json) {     
      html='';
    if (json['zone'] != '' && undefined !=json['zone']) {
        html = '<option value="">--Please Select--</option>';
        for (i = 0; i < json['zone'].length; i++) {
              html += '<option value="' + json['zone'][i]['zone_id'] + '"';
            
          if (json['zone'][i]['zone_id'] =='{{ xconfig.options.zone_id  and  xconfig.options.zone_id?xconfig.options.zone_id:"" }}') {
                html += ' selected="selected"';
            }
  
                 html += '>' + json['zone'][i]['name'] + '</option>';
        }
      } else {
        html += '<option value="0" selected="selected">--None--</option>';
      }
      
      $('select[name=\'options[zone_id]\']').html(html);
    },
    error: function(xhr, ajaxOptions, thrownError) {
      alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
    }
  });
});
$('select[name=\'options[country_id]\']').trigger('change');
$('input[name=\'design[type]\']').bind('change', function() {
	changeDesign();
});
function changeDesign(){
	if($('input[name=\'design[type]\']:checked').val() == 'custom'){
		$('.custom-colors').show();
	 }else{
		$('.custom-colors').hide();
	 }
}
changeDesign();
$(function() {
    $('.colorpicker-component').colorpicker({
		'format':'hex'
    });
});
$(document).on("submit", "#form_validate", function(event) {	
	event.preventDefault();	
	$('.validatelicense').trigger('click');
});
{% if config_license['module_xtensions_checkout_activation_code'] is not defined  %}
function submitLicense(activation_code,license_code,user_name,date_support,message){
	$.ajax({
	    url: 'index.php?route={{ xtensions_admin_xcheckout_path }}/license&user_token={{ user_token }}&activation_code=' + activation_code +'&license_code=' + license_code +'&user_name=' + user_name +'&date_support=' + date_support,
	    dataType: 'json',          
	    success: function(json) {
	      $('#form_validate').before('<div class="alert alert-success"><i class="fa fa-check-circle-o"></i> '+message+'</div>');     
	      $('#form_validate').remove();
	    },
	    error: function(xhr, ajaxOptions, thrownError) {
	      alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
	    }
	  });
}
{% endif %}
</script>
<script type="text/javascript">
 var codemirrorcssold;
 var codemirrorjsold;
 window.onload = function () {
 var codemirrorCss = CodeMirror.fromTextArea(document.querySelector('#custom_css'), {
		mode: 'text/css',
		height: '500px',
		lineNumbers: true,
		theme: 'oceanic-next',
		extraKeys: {"Ctrl-Space": "autocomplete"},
	});
 codemirrorCss.refresh();
 codemirrorcssold = codemirrorCss;
 var codemirrorJs = CodeMirror.fromTextArea(document.querySelector('#custom_js'), {
		mode: 'text/javascript',
		height: '500px',
		lineNumbers: true,
		theme: 'oceanic-next',
		extraKeys: {"Ctrl-Space": "autocomplete"},
	});
 codemirrorJs.refresh();
codemirrorjsold = codemirrorJs;
 };
$('a[data-toggle="tab"]').on('shown.bs.tab', function (e) {	
	var target = $(e.target).attr("href");
	if(target == '#tab-css'){
		codemirrorcssold.refresh();
	}else if(target == '#tab-js'){		
		codemirrorjsold.refresh();
	}
});
</script>

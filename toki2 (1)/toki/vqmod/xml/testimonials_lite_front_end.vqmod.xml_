<?xml version="1.0" encoding="UTF-8"?>
<modification>
    <id>Testimonials Lite Front End</id>
    <version>1.4.2</version>
    <author>vanstudio.co.ua</author>
    <file name="catalog/view/theme/*/template/common/footer.twig">
        <operation>
            <search position="after"><![CDATA[<li><a href="{{ contact }}">{{ text_contact }}</a></li>]]></search>
            <add><![CDATA[
                <li><a href="{{ testimonial['href'] }}">{{ text_testimonial }}</a></li>
            ]]></add>
        </operation>
    </file>


    <file path="catalog/language/ar/ar.php">
        <operation>
                <search><![CDATA[// Buttons]]></search>
                <add position="after"><![CDATA[$_['text_testimonial']    = 'اراء العملاء';]]></add>
            </operation>
    </file>
    <file path="catalog/language/en-gb/en-gb.php">
        <operation>
                <search><![CDATA[// Buttons]]></search>
                <add position="after"><![CDATA[$_['text_testimonial']    = 'Testimonials';]]></add>
            </operation>
    </file>



    <file name="catalog/controller/common/footer.php">
        <operation>
            <search position="before"><![CDATA[$data['informations'] = array();]]></search>
            <add><![CDATA[
                $data['testimonial'] = array(
                    'title' => 'Testimonials',
                    'href'  => $this->url->link('testimonial/testimonial')
                );
            ]]></add>
        </operation>
    </file>
</modification>
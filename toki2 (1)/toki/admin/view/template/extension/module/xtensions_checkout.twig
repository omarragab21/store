<div id="tab-export-import" class="tab-pane">
<form action="{{ export }}" method="post" enctype="multipart/form-data" id="formexport" class="form-horizontal">
<table class="table">
          <thead>            
            <tr>
              <td colspan="2"><i class="fa fa-download"></i>&nbsp;{{ button_export_settings }}</td>                                          
            </tr>
          </thead>               
              <tr>
              <td style="width: 30%;">
              <select name="export_store_id" class="form-control">
			  <option value="0" {{ store_id == 0?'selected="selected"':'' }}>{{ default_heading }}</option>			  
	          {% for store in stores %} 
	  		  <option value="{{ store.store_id }}" {{ store_id == store.store_id?'selected="selected"':'' }}>{{ store.name }}</option>
	          {% endfor %} 
			  </select>
	  		  </td>              
        	  <td> 
        	  <input type="submit" value="{{ button_submit }}" data-toggle="tooltip" title="{{ button_export_settings }}" class="btn btn-primary" />
        	  </td>
              </tr>                                                       
</table>
</form>
<form action="{{ import }}" method="post" enctype="multipart/form-data" id="formimport" class="form-horizontal">
<table class="table">

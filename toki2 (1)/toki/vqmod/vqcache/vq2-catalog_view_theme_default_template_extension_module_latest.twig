<div class="latest-all">
    <div class="container  ">

        <div class="haed-item">
            <h2>{{ heading_best }}</h2>
            <a class="head-item-btn" href="index.php?route=product/latest">
                <span>{{ heading_best_all }} </span>
            </a>
        </div>
        <div class="latest-cont">
         

                <div id="latest0" class="latest " dir="{{ direction }}">
                    

                        {% for product in products %}
                           
                                <div class="product-layout col-sm-3 col-xs-6">
                                    <div class="product-thumb transition">
                                        <div class="image">
{% if (product['special']) %}<div class="ribbon"><span>  {{ product['percent'] }}</span></div>{% endif %}
                                            <a href="{{ product.href }}">
                                                <img
                                                        src="{{ product.thumb }}"
                                                        alt="{{ product.name }}"
                                                        title="{{ product.name }}"
                                                        class="img-responsive"/>
                                            </a>

                                            <button type="button" class="wish" data-toggle="tooltip"  title="{{ button_wishlist }}" onclick="wishlist.add('{{ product.product_id }}');"><i class="fa fa-heart-o"></i></button>
                                        </div>
                                        <div class="product-thumb-content">
                                            <div class="caption">
<p class="p-cat"> <a href="{{ product['category_link'] }}">{{ product['category_adi'] }}</a></p> 
                                                <h4><a href="{{ product.href }}">{{ product.name }}</a></h4>


                                                {# <p>{{ product.description }}</p> #}
                                                <div class="rating">{% for i in 1..5 %}
                                                            {% if product.rating < i %} <span class="fa fa-stack"><i
                                                                        class="fa fa-star-p fa-star fa-stack-2x"></i></span> {% else %}
                                                                <span class="fa fa-stack"><i
                                                                            class="fa fa-star fa-stack-2x"></i><i
                                                                            class="fa fa-star-p fa-star fa-stack-2x"></i></span> {% endif %}
                                                        {% endfor %}</div>
                                                <div class="caption-cont">

                                                    {% if product.price %}
                                                        <p class="price"> 
                                                            {% if not product.special %}
                                                                {{ product.price }}
                                                            {% else %} 
                                                            <span class="price-new">{{ product.special }}</span>
                                                                <span class="price-old">{{ product.price }}</span> {% endif %}
                                                            {% if product.tax %} <span
                                                                    class="price-tax">  </span> {% endif %}
                                                        </p>
                                                    {% endif %}
                                                    
                                                </div>
                                                <div class="button-group">
                                                    <button type="button" class="add_cart" onclick="cart.add('{{ product.product_id }}');" >
                                                        <span>{{ button_cart }}</span>
                                                    </button>
                                                    {# <button type="button" data-toggle="tooltip" #}
                                                    {# title="{{ button_wishlist }}" #}
                                                    {# onclick="wishlist.add('{{ product.product_id }}');"><i #}
                                                    {# class="fa fa-heart"></i></button> #}
                                                    {# <button type="button" data-toggle="tooltip" #}
                                                    {# title="{{ button_compare }}" #}
                                                    {# onclick="compare.add('{{ product.product_id }}');"> #}
                                                    {# <i class="fa  fa-search"></i></button> #}

                                                </div>


                                            </div>


                                        </div>
                                    </div>
                                </div>
                            

                        {% endfor %}

                    
                </div>
            
        </div>


        <script type="text/javascript"><!--
            $('#latest0').swiper({
                mode: 'horizontal',
                slidesPerView: 4,
                // pagination: '.special0',
                paginationClickable: false,
                nextButton: '.swiper-button-next',
                prevButton: '.swiper-button-prev',
                spaceBetween: 30,
                autoplay: 3000,
                speed: 700,


                autoplayDisableOnInteraction: true,
                loop: false,
                breakpoints: {
                    // when window width is <= 499px
                    768: {
                        slidesPerView: 3,
                        spaceBetween: 15,

                    },
                    499: {
                        slidesPerView: 2,
                        spaceBetween: 15,

                    },
                }
            });
            --></script>
    </div>
</div>


{% if (reviews) %} 
{% for review in reviews %} 
<table class="table table-striped table-bordered">
  <tr>
    <td style="width: 50%;">
      <strong>{{ review['author'] }}</strong> 
      <strong>{{ review['job'] }}</strong>
    </td>
    <td class="text-right">{{ review['date_added'] }}</td>
  </tr>
  <tr>
    <td colspan="2"><p>{{ review['text'] }}</p>
      {% set i = 1 %}{% for i in i..5 %} 
      {% if (review['rating'] < i) %} 
      <span class="fa fa-stack"><i class="fa fa-star-o fa-stack-2x" style='color: #FC0;'></i></span>
      {% else %} 
      <span class="fa fa-stack"><i class="fa fa-star fa-stack-2x" style='color: #FC0;'></i><i class="fa fa-star-o fa-stack-2x" style='color: #E69500;'></i></span>
      {% endif %} 
      {% endfor %} 
    </td>
  </tr>
</table>
{% endfor %} 
<div class="row">
  <div class="col-sm-6 text-left">{{ pagination }}</div>
  <div class="col-sm-6 text-right">{{ results }}</div>
</div>
{% else %} 
<p>{{ text_no_reviews }}</p>
{% endif %} 

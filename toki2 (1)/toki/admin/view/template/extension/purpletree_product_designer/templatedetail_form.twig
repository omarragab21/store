		html += '<td class="text-left" id="thumb-img-td-'+image_design_row+'"><a href="" id="thumb-design-image' + image_design_row + '"data-toggle="image" class="img-thumbnail"><img src="{{ placeholder }}" alt="" title="" data-placeholder="{{ placeholder }}" /></a><img style="display:none" id="thumb-design-thumb{{ image_design_row }}" src="{{ product_design_image.design_thumb }}" /><input type="hidden" name="product_design_image[' + image_design_row + '][image]" value="" id="input-design-image' + image_design_row + '" /><div class="divheightwidth text-left" id="without-img-td-'+image_design_row +'" style="display:none"><div class="col-sm-9 "> <div class="col-sm-5 ">Width</div><div class="col-sm-7 "><input type="text" name="product_design_image['+ image_design_row +'][width]" value="550" placeholder="width" class="form-control" /></div></div><div class="col-sm-9 "><div class="col-sm-5 ">Height</div> <div class="col-sm-7 "><input type="text" name="product_design_image['+image_design_row +'][height]" value="550" placeholder="{{ text_height }}" class="form-control" /></div></div></div></td>';
		
		html += '<td class="text-center"><div id="alwaysontop'+ image_design_row +'"  class="ptsalwaysontop"><input style="margin-right: 4px;" id="alwaysontopcheckbox'+ image_design_row +'" type="checkbox" name="product_design_image['+ image_design_row +'][alwaysontop]" value="0" /></div></td>';
		html += '<td class="text-right"><span class="btn btn-primary" id="create-canvas_'+ image_design_row +'" >{{ entry_create_canvas }}</span><div id="canvas-area-' + image_design_row + '"><div> </td>';

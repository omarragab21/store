{% if    display_comments  %} 
<div id="commentModal" class="modal fixed dropdownModal nobottom"  tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
    <form role="form" id="form_add_comment" action="#" method="post" enctype="multipart/form-data">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">&times;</span><span class="sr-only"></span></button>
        <h4 class="modal-title">{{ comment_apply_text }}</h4>
      </div>
      <div class="modal-body margintop20" id="comment-panel">
      	<div class="loader cvcLoader"></div>
      	<div class="group{{ comment?' filled':'' }}">
     		<textarea rows="8" cols="40" class="inputMaterial" name="comment">{{ comment }}</textarea>
     		<label>{{ comment_apply_text }}</label>
    	</div>
    	<div class="buttons"><button id="commentbtn" type="submit" class="btn btn-success width100">{{ comment_apply_text }}</button></div>
    	<div class="showonsuccess" style="display: none;">
	    <div class="circle-loader">
		  <div class="checkmark draw"></div>
		</div>
	    <div class="text-center"><a data-dismiss="modal" class="btn btn-coupon btnwidth200">{{ button_close }}</a></div>
	    </div>
    	</div>     
   		</form>
    </div>
  </div>
</div>
{% endif %}

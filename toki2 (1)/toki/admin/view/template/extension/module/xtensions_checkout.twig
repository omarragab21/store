{{ header }}{{ column_left }} 
<div id="content">
<div class="page-header">
    <div class="container-fluid">
       <div class="pull-right">
        <button type="submit" form="form-xcheckout" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i> {{ text_save_and_stay }}</button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i> {{ text_cancel_or_back }}</a>
        </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %} 
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %} 
      </ul>
    </div>
  </div>
  <div class="container-fluid">
   <div class="panel panel-default">
      <div class="panel-heading">
      <div class="row">
      <h3 class="panel-title col-sm-12">
      <span class="col-sm-10 "><i class="fa fa-pencil"></i> {{ edit_heading }}: {{ heading_title }} <b>{{ text_version~xtensions_version }}</b></span>
      <span class="col-sm-2 text-right">
	  <select name="store_id" class="form-control">
	  <option value="0" {{ store_id == 0?'selected="selected"':'' }}>{{ default_heading }}</option>
	  {% for store in stores %} 
	  <option value="{{ store.store_id }}" {{ store_id == store.store_id?'selected="selected"':'' }}>{{ store.name }}</option>
	  {% endfor %} 
	  </select>
	  </span>
      </h3>
      </div>
      <div class="clearfix"></div>
      </div>   
    <div class="panel-body">
    <ul class="nav nav-tabs tab-horizontal">         
		<li class="active"><a href="#tab-module" data-toggle="tab">{{ tab_module_settings }}</a></li>
		<li><a href="#tab-export-import" data-toggle="tab">{{ tab_export_import }}</a></li>
		<li><a href="#tab-support-license" data-toggle="tab">{{ help_heading }}<new></new></a></li>
	</ul>
	<div class="tab-content">
	<div id="tab-module" class="tab-pane active">
      <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-xcheckout">        
   {% if error_warning %} 
    	<div class="alert alert-warning"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}<button type="button" class="close" data-dismiss="alert">&times;</button></div>
   {% endif %}     
   {% if success %} 
    	<div class="alert alert-success"><i class="fa fa-exclamation-circle"></i> {{ success }}<button type="button" class="close" data-dismiss="alert">&times;</button></div>
   {% endif %}
{% if config_license['module_xtensions_checkout_activation_code'] is not defined  %}
<div class="row xtensionsalertmain">
<div class="col-sm-12">
<div class="alert alert-danger">{{ text_license_alert_2 }}<span style="margin-left:20px"><a onclick="$('.nav-tabs a[href=#tab-support-license]').tab('show');$('.nav-tabs a[href=#tab-license]').tab('show');" class="btn btn-success">{{ text_license_activate }}</a></span><button type="button" class="close" data-dismiss="alert">&times;</button></div>
</div>
</div>
{% endif %}
<div class="well-xinfo mb20">
<div class="row">
<div class="col-sm-4">
    <div class="input-group">
        <span class="input-group-addon">{{ module_heading_title }}</span>
        <span class="input-group-addon" style="width: 100%;background: #fff;text-align: left;">
        	<label class="switch big_switch"><input type="checkbox" class="switch-input" value="1" name="status" {% if ((xconfig.status is defined and xconfig.status)) %} {{ 'checked' }}{% endif %} /><span class="switch-label" data-on="Yes" data-off="No"></span> <span class="switch-handle"></span></label>	
        </span>
    </div>
</div>
<div class="col-sm-4">
    <div class="input-group" style="margin-top: 10px">
        <span class="input-group-addon">{{ default_country_heading }}</span>
        <select class="form-control" name="options[country_id]">
            <option value="0">{{ select_option_heading }}</option>
            {% for country in countries %} 
            {% if  xconfig.options.country_id is defined and xconfig.options.country_id == country.country_id %} 
            <option value="{{ country.country_id }}" selected="selected">{{ country.name }}</option>
            {% else %} 
            <option value="{{ country.country_id }}">{{ country.name }}</option>
            {% endif %} 
            {% endfor %} 
        </select>
    </div>
</div>
<div class="col-sm-4">
    <div class="input-group" style="margin-top: 10px">
        <span class="input-group-addon">{{ default_default_state_region }}</span>
        <select class="form-control" name="options[zone_id]"></select>
    </div>
</div>
</div>
</div>
<div class="row">
<div class="col-sm-3">
<nav id="login-tabs" class="nav-sidebar">
<ul class="nav nav-tabs tabs-left" id="tab-xcheckout"> 
<li class="active"><a href="#tab-fields" data-toggle="tab">{{ text_fields_heading }}</a></li>         
<li><a href="#tab-sort" data-toggle="tab">{{ sorting_heading }}</a></li>
<li><a href="#tab-validation" data-toggle="tab">{{ validation_heading }}</a></li>
<li><a href="#tab-ctry-code" data-toggle="tab">{{ tab_ctry_code }}</a></li>
<li><a href="#tab-language" data-toggle="tab">{{ language_heading }}</a></li>         
<li><a href="#tab-sub-misc" data-toggle="tab">{{ checkout_misc_heading }}<new></new></a></li>
<li><a href="#tab-header" data-toggle="tab">{{ tab_header }}</a></li>
<li><a href="#tab-footer" data-toggle="tab">{{ tab_footer }}</a></li>
<li><a href="#tab-payment" data-toggle="tab">{{ tab_payment_methods }}</a></li>
<li><a href="#tab-shipping" data-toggle="tab">{{ tab_shipping_methods }}</a></li>
<li><a href="#tab-cart" data-toggle="tab">{{ tab_cart }}</a></li>
<li><a href="#tab-cvr" data-toggle="tab">{{ tab_cvr }}</a></li>
<li><a href="#tab-order" data-toggle="tab">{{ order_heading }}</a></li>
<li><a href="#tab-social" data-toggle="tab">{{ social_login_heading }}<new></new></a></li>
<li><a href="#tab-colors" data-toggle="tab">{{ custom_colors_heading }}</a></li>
<li><a href="#tab-css" data-toggle="tab">{{ custom_css_tab_heading }}</a></li>
<li><a href="#tab-js" data-toggle="tab">{{ custom_js_tab_heading }}</a></li>
</ul>
</nav>
{{ text_new_setting }}                       
</div>
<div class="col-sm-9">
<div class="tab-content"> 
<div id="tab-fields" class="tab-pane active">  
<ul class="nav nav-tabs tab-horizontal">         
<li class="active"><a href="#tab-reg" data-toggle="tab">{{ register_area_heading }}</a></li>
<li><a href="#tab-edit" data-toggle="tab">{{ edit_area_heading }}</a></li>
<li><a href="#tab-checkout" data-toggle="tab">{{ guest_area_heading }}</a></li>
</ul>
<div class="tab-content">
<div id="tab-reg" class="tab-pane active">
<div class="row">
<div class="col-md-12">
<div class="table-responsive">
<table class="table">
          <thead>            
            <tr>
              <td class="text-center" width="40%">{{ register_page_field_heading }}</td> 
              <td class="text-center" width="30%"></td>
              <td class="text-center" width="30%"></td>          
            </tr>
          </thead>
               <tr>
                  <td class="text-center">
                   {{ single_section_heading }}<div class="help">(Account, Address, password will appear in single section)</div>
                  </td>                  
                  <td class="text-center">
                  	<label class="switch"><input type="checkbox" class="switch-input" value="1"  name="options[single_box]" {% if xconfig.options.single_box is not defined or (xconfig.options.single_box is defined and xconfig.options.single_box) %} {{ 'checked' }}{% endif %} /><span class="switch-label" data-on="Yes" data-off="No"></span> <span class="switch-handle"></span></label>
  				  </td> 
  				  <td></td>                            
               </tr>
               <thead>            
            <tr>
            	<td></td>
               <td class="text-center">{{ show_title }}</td>
              <td class="text-center">{{ required_title }}</td>
              </tr> 
              </thead>      
               {% for key,field in fields %} 
               {% if (field.register or (field.mandatory is defined and field.mandatory)) %} 
		          <tr>
					<td class="text-center">
                    {{ field_title[key] }}
					{{ field.title is defined?'<div class="help">'~field.title~'</div>':'' }}
					</td>
					<td class="text-center">
					{% if (field.mandatory is defined and field.mandatory) %} 
						{% if (key == 'customer_group_id') %} 
						<div class="help">{{ always_displayed_in_store }}</div> 
						{% else %} 
						<div class="help">{{ always_displayed }}</div> 
						{% endif %} 
					{% elseif (field.register and field.mandataory is not defined) %}                  
		            <label class="switch"><input type="checkbox" class="switch-input" value ="1" name="register[{{ key }}][show]" {{ xconfig.register[key].show is defined?'checked="checked"':'' }} /><span class="switch-label" data-on="Yes" data-off="No"></span> <span class="switch-handle"></span></label>
		            {% endif %} 
		            </td>
		            <td class="text-center">
		            {% if (field.required_default is defined and field.required_default) %} 
		            <div class="help">{{ always_mandatory_heading }}</div> 
		            {% elseif (field.required is defined and not field.required) %} 
		            <div class="help">{{ cannot_mandatory_heading }}</div> 
		            {% else %} 
		            <label class="switch"><input type="checkbox" class="switch-input" value="1"  name="register[{{ key }}][required]" {{ xconfig.register[key].required is defined?'checked="checked"':'' }} {{ not field.required?'disabled="disabled"':'' }} /><span class="switch-label" data-on="Yes" data-off="No"></span> <span class="switch-handle"></span></label>
		            {% endif %} 
		            </td>          
				  </tr>
				{% endif %} 
          	  {% endfor %} 
              
</table>
</div>
</div>
</div> 
</div>
<div id="tab-edit" class="tab-pane">
<div class="table-responsive">
<table class="table">
          <thead>            
            <tr>
              <td class="text-center">{{ personal_details_account_heading }}</td>              
              <td class="text-center" width="30%">{{ show_title }}</td>
              <td class="text-center" width="30%">{{ required_title }}</td>                            
            </tr>
          </thead>
               {% for key,field in fields %} 
               {% if ( (field.edit and field.location in ['account','both']) or (field.edit and field.mandatory is defined and field.mandatory)) %}
		          <tr>
					<td class="text-center">
					{{ field_title[key] }}
					{{ field.title is defined?'<div class="help">'~field.title~'</div>':'' }}
					</td>                  
		            <td class="text-center">
		            {% if (field.mandatory is defined and field.mandatory ) %} 
		            	<div class="help">{{ always_displayed }}</div> 
		            {% elseif (field.edit and field.mandataory is not defined) %} 
		            <label class="switch"><input type="checkbox" class="switch-input" value ="1" name="edit[account][{{ key }}][show]" {{ xconfig.edit.account[key].show is defined?'checked="checked"':'' }}  /><span class="switch-label" data-on="Yes" data-off="No"></span> <span class="switch-handle"></span></label> 
		            {% endif %} 
		            </td>
		            <td class="text-center">
		            {% if (field.required_default is defined and field.required_default) %} 
		            <div class="help">{{ always_mandatory_heading }}</div> 
		            {% elseif (field.required is defined and not field.required) %} 
		            <div class="help">{{ cannot_mandatory_heading }}</div> 
		            {% else %} 
		            <label class="switch"><input type="checkbox" class="switch-input" value="1"  name="edit[account][{{ key }}][required]" {{ not field.required?'disabled="disabled"':'' }} {{ xconfig.edit.account[key].required is defined?'checked="checked"':'' }} /><span class="switch-label" data-on="Yes" data-off="No"></span> <span class="switch-handle"></span></label>
		            {% endif %} 
		            </td>            
				  </tr>
				{% endif %} 
          	  {% endfor %} 
</table>
</div> 
<div class="table-responsive">
<table class="table">
          <thead>            
            <tr>
              <td class="text-center">{{ personal_details_address_heading }}</td>              
              <td class="text-center" width="30%">{{ show_title }}</td>
              <td class="text-center" width="30%">{{ required_title }}</td>                            
            </tr>
          </thead>
               {% for key,field in fields %} 
               {% if (field.edit and field.location in ['address','both'] ) %}
		          <tr>
					<td class="text-center">
					{{ field_title[key] }}
					{{ field.title is defined?'<div class="help">'~field.title~'</div>':'' }}
					</td>                  
		            <td class="text-center"><label class="switch"><input type="checkbox" class="switch-input" value ="1" name="edit[address][{{ key }}][show]" {{ xconfig.edit.address[key].show is defined?'checked="checked"':'' }} /><span class="switch-label" data-on="Yes" data-off="No"></span> <span class="switch-handle"></span></label></td>
		            <td class="text-center">
		            {% if (field.required_default is defined and field.required_default) %} 
		            <div class="help">{{ always_mandatory_heading }}</div> 
		            {% elseif (field.required is defined and not field.required) %} 
		            <div class="help">{{ cannot_mandatory_heading }}</div> 
		            {% else %} 
		            <label class="switch"><input type="checkbox" class="switch-input" value="1"  name="edit[address][{{ key }}][required]" {{ not field.required?'disabled="disabled"':'' }} {{ xconfig.edit.address[key].required is defined?'checked="checked"':'' }} /><span class="switch-label" data-on="Yes" data-off="No"></span> <span class="switch-handle"></span></label>
		            {% endif %} 
		            </td>            
				  </tr>
				{% endif %} 
          	  {% endfor %} 
</table>
</div>           
</div>                                  
<div id="tab-checkout" class="tab-pane">
<div class="table-responsive"><table class="table">
          <thead>            
            <tr>
              <td class="text-center" width="40%">{{ account_guest_heading }}</td>              
              <td class="text-center" width="30%">{{ show_title }}</td>
              <td class="text-center" width="30%">{{ required_title }}</td>                            
            </tr>
          </thead>
               {% for key,field in fields %} 
               {% if ((field.checkout and field.location in ['account','both']) or (field.checkout and field.mandatory is defined and field.mandatory) ) %}
		          <tr>
					<td class="text-center">					
					{{ field_title[key] }}
					{{ field.title is defined?'<div class="help">'~field.title~'</div>':'' }}					 
					{% if (field.guest is defined and not field.guest) %} 
					<div class="help">{{ guest_area_subheading }}</div>
					{% endif %} 
					</td>                  
		            <td class="text-center">
		            {% if (field.mandatory is defined and field.mandatory ) %} 
		            	{% if (key == 'customer_group_id') %} 
						<div class="help">{{ always_displayed_in_store }}</div> 
						{% else %} 
						<div class="help">{{ always_displayed }}</div>
						{% endif %} 
		            {% elseif (field.checkout and field.mandataory is not defined) %} 
		            <label class="switch"><input type="checkbox" class="switch-input" value ="1" name="checkout[account][{{ key }}][show]" {{ xconfig.checkout.account[key].show is defined?'checked="checked"':'' }}  /><span class="switch-label" data-on="Yes" data-off="No"></span> <span class="switch-handle"></span></label> 
		            {% endif %}		            
		            </td>
		            <td class="text-center">
		            {% if (field.required_default is defined and field.required_default) %} 
		            <div class="help">{{ always_mandatory_heading }}</div> 
		            {% elseif (field.required is defined and not field.required) %} 
		            <div class="help">{{ cannot_mandatory_heading }}</div> 
		            {% else %} 
		            <label class="switch"><input type="checkbox" class="switch-input" value="1"  name="checkout[account][{{ key }}][required]" {{ not field.required?'disabled="disabled"':'' }} {{ xconfig.checkout.account[key].required is defined?'checked="checked"':'' }} /><span class="switch-label" data-on="Yes" data-off="No"></span> <span class="switch-handle"></span></label>
		            {% endif %} 
		            </td>            
				  </tr>
				{% endif %} 
          	  {% endfor %} 
</table>  
</div>  
<div class="table-responsive">
<table class="table">
          <thead>            
            <tr>
              <td class="text-center" width="40%">{{ address_panel_heading }}</td>              
              <td class="text-center" width="30%">{{ show_title }}</td>
              <td class="text-center" width="30%">{{ required_title }}</td>                           
            </tr>
          </thead>
               {% for key,field in fields %} 
               {% if (field.checkout and field.location in ['address','both']) %}               
		          <tr>
					<td class="text-center">
					{{ field_title[key] }}
					{{ field.title is defined?'<div class="help">'~field.title~'</div>':'' }}
					</td>                
		            <td class="text-center"><label class="switch"><input type="checkbox" class="switch-input" value ="1" name="checkout[address][{{ key }}][show]" {{ xconfig.checkout.address[key].show is defined?'checked="checked"':'' }} /><span class="switch-label" data-on="Yes" data-off="No"></span> <span class="switch-handle"></span></label></td>
		            <td class="text-center">
		            {% if (field.required_default is defined and field.required_default) %} 
		            <div class="help">{{ always_mandatory_heading }}</div> 
		            {% elseif (field.required is defined and not field.required) %} 
		            <div class="help">{{ cannot_mandatory_heading }}</div> 
		            {% else %} 
		            <label class="switch"><input type="checkbox" class="switch-input" value="1"  name="checkout[address][{{ key }}][required]" {{ xconfig.checkout.address[key].required is defined?'checked="checked"':'' }} /><span class="switch-label" data-on="Yes" data-off="No"></span> <span class="switch-handle"></span></label>
		            {% endif %}        
		            </td>  
				  </tr>
				{% endif %} 
          	  {% endfor %} 
</table>  
</div>           
</div>
</div>
</div>
<div id="tab-sort" class="tab-pane">
<div class="table-responsive">
<table class="table">
          <thead>            
            <tr>
              <td class="text-center" width="30%">{{ field_name_heading }}</td>              
              <td width="70%">{{ sort_name_heading }}</td>                                          
            </tr>
          </thead>
          {% for key,field in fields %} 
          {% if (key not in ['newsletter','agree']) %}                   
           <tr>
            <td class="text-center">{{ field_title[key] }}</td>                  
        	<td><input type="number" name="sort_order[fields][{{ key }}]" value="{{ xconfig.sort_order.fields[key] is defined ? xconfig.sort_order.fields[key] : field.sort_order is defined ? field.sort_order : '' }}" size="6"  class="form-control"/></td>        	
           </tr>
           {% endif %} 
        {% endfor %} 
        {% if (custom_fields|length > 0) %}
        {% set count_custom_fields = 1 %} 
        {% for field in custom_fields %} 
          <tr>
          <td>{{ field.name }} - {{ custom_field_heading }} (<span style="text-transform: capitalize;">{{ field.location }}</span>)</td>                  
          <td><input type="number" name="sort_order[custom_fields][{{ field.custom_field_id }}]" value="{{ xconfig.sort_order.custom_fields[field.custom_field_id] is defined ? xconfig.sort_order.custom_fields[field.custom_field_id] : count_custom_fields*5 }}" size="6"  class="form-control"/></td>
          </tr>
          {% set count_custom_fields = count_custom_fields + 1 %} 
          {% endfor %} 
          {% endif %} 
</table> 
<table class="table">
          <thead>            
            <tr>
              <td class="text-center" width="30%">{{ account_tab_heading }}</td>              
              <td width="70%">{{ sort_number_heading }}</td>                                          
            </tr>
          </thead>
          {% for key,value in {'login':1,'register':2,'guest':3} %}                 
           <tr>
            <td class="text-center"><span style="text-transform: capitalize;">{{ key }}</span></td>                  
        	<td><input type="number" name="sort_order[account][{{ key }}]" value="{{ xconfig['sort_order']['account'][key] is defined?xconfig['sort_order']['account'][key]:value }}" size="6"  class="form-control"/></td>        	
           </tr>
           {% endfor %}
</table>           
</div>
</div>
<div id="tab-validation" class="tab-pane">
<div class="table-responsive">
<table class="table">
          <thead>            
            <tr>
              <td class="text-center" width="20%">{{ validation_heading }}</td>           
              <td width="10%">{{ minimum_characters_heading }}</td>
              <td width="10%">{{ maximum_characters_heading }}</td>              
              <td width="10%">{{ numeric_heading }}</td>     
              <td width="25%">{{ masking_heading }}</td> 
              <td width="25%">{{ regex_heading }}</td>
            </tr>            
          </thead>  
          {% for key, field in fields %}
           {% if  field.minimum  or  field.maximum%}
           {% if key not in ['confirm','confirm_email','confirm_telephone'] %}                     
           <tr>           
            <td class="text-center">{{ field_title[key] }}</td>
        	<td><input type="text" size="6" name="validation[{{ key }}][minimum]" value="{{ xconfig['validation'][key]['minimum'] ? xconfig['validation'][key]['minimum'] : field.minimum_default ? field.minimum_default: '' }}" class="form-control"/></td>
        	<td><input type="text" size="6" name="validation[{{ key }}][maximim]" value="{{ xconfig['validation'][key]['maximim'] ? xconfig['validation'][key]['maximim'] : field.maximum_default ? field.maximum_default: '' }}" class="form-control"/></td>        	
        	{% if  field.is_numeric  or  field.is_masking %}            
        	<td><label class="switch"><input type="checkbox" class="switch-input" value="1" name="validation[{{ key }}][numeric]" {{ xconfig['validation'][key]['numeric']?'checked="checked"': '' }}/><span class="switch-label" data-on="Yes" data-off="No"></span> <span class="switch-handle"></span></label></td>
        	<td><input type="text" name="validation[{{ key }}][mask]" value="{{ xconfig['validation'][key]['mask']?xconfig['validation'][key]['mask']:'' }}" placeholder="Masking" title="CEP Brasil-99999-999" class="form-control"/></td>           
            {% else %}
            <td colspan="2" class="text-center"><i class="fa fa-times-circle" aria-hidden="true"></i></td>
            {% endif %}			
            {% if  field.regex %}
        	<td><input type="text" name="validation[{{ key }}][regex]" value="{{ xconfig['validation'][key]['regex']?xconfig['validation'][key]['regex']: '' }}" placeholder="Regex" class="form-control"/></td>           
            {% else %}
            <td colspan="1" class="text-center"><i class="fa fa-times-circle" aria-hidden="true"></i></td>
            {% endif %}                           	
           	</tr>  
           	{% endif %} 
           {% endif %}
           {% endfor %}     

                  
</table> 
</div>           
</div>
<div id="tab-language" class="tab-pane">
<div class="table-responsive"><table class="table">
          <thead>            
            <tr>
              <td width="0%" class="hidden"></td>
              <td width="25%">{{ title_heading }}</td>  
              <td width="40%">{{ error_message_heading }}</td>            
              <td width="35%">{{ tooltip_heading }}</td>                  
            </tr>            
          </thead> 
          {% for key, field in fields %}    
          <thead>
            <tr>
              <td width="0%" class="hidden"></td><td class="small">{{ field_title[key] }}</td><td></td><td></td>                              
            </tr>             
          </thead>                            
           <tr>
           <td width="0%" class="hidden"></td>        
        	<td>
        	{% for language in languages %} 
        	<div class="input-group">
        	<span title="{{ language.name }}" class="input-group-addon"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" /></span>
        	<input type="text" name="titles[{{ key }}][title][{{ language.language_id }}]" value="{{ xconfig['titles'][key]['title'][language['language_id']]?xconfig['titles'][key]['title'][language['language_id']]:'' }}" placeholder="{{ title_heading }}" class="form-control" />                  
        	</div>
        	{% endfor %}        	
        	</td>
        	<td>

<div class="cats">

            <h2>{{ heading_title }}</h2>

    <div class="container">
  <div class="swiper-viewport">
  <div id="cats1" class="swiper-container">
    <div class="swiper-wrapper">
  {% for category in categories %}
  {% if category.category_id == category_id %} 
  <a href="{{ category.href }}" class="list-group-item active">{{ category.name }}</a> 
  {% if category.children %}
  {% for child in category.children %}
  {% if child.category_id == child_id %}
  <a href="{{ child.href }}" class="list-group-item active">&nbsp;&nbsp;&nbsp;- {{ child.name }}</a> 
  {% else %} 
  <a href="{{ child.href }}" class="list-group-item">&nbsp;&nbsp;&nbsp;- {{ child.name }}</a>
  {% endif %}
  {% endfor %}
  {% endif %}
  {% else %} 


<div class="swiper-slide"> 
          <div class="home-cats">
                <div class="image" title="{{ category['title'] }}">
                  <a href="{{ category['href'] }}" title="{{ category['title'] }}">
                        <img src="{{ category['image'] }}" class="img-responsive" /> 
                  </a>
                  <a href="{{ category['href'] }}" title="{{ category['title'] }}" class="cat-title">{{ category['title'] }}</a>
                </div>
        </div>
</div>

  {% endif %}
  {% endfor %}
</div>


</div>

<div class="swiper-pagination category0"></div> 
             <div class="swiper-pager category0-pager"> 
             <div class="category0-next swiper-button-next"></div> 
             <div class="category0-prev swiper-button-prev"></div> 
             </div> 


</div>
    </div>
</div>

 <script type="text/javascript">
 $('#cats1').swiper({ 
 mode: 'horizontal', 
 slidesPerView: 7, 
 // pagination: '.category0', 
 paginationClickable: false, 
 nextButton: '.category0-next', 
 prevButton: '.category0-prev', 
 spaceBetween: 30, 
 autoplay: 3000, 
 speed: 700, 
 autoplayDisableOnInteraction: true, 
 loop: false, 
 breakpoints: { 
    768: { 
     slidesPerView: 4, 
 }, 
 // when window width is <= 499px 
 499: { 
     slidesPerView: 4, 
      spaceBetween: 15, 
 }, 
 } 
 }); 
</script> 


<div class="container  ">
        <div class="row">
<div id="banner33{{ module }}_" class="">
<div class="haed-item">
  {% if direction == 'rtl' %}
       <h2> {{bann_name}}</h2>
  {% else %}
         <h2> {{bann_name2}} </h2>
   {% endif %}

   <a class="head-item-btn" href="{{ bann_blink }}">{{ heading_best_all }}</a>
 </div>

<div id="banner33{{ module }}" class=" swiper-viewport" dir="{{ direction }}">
    <div id="carousel-banner33{{ module }}" class="swiper-container">
        <div class="swiper-wrapper main-products-caro">
       {% for banner in banners %}
       <div class="swiper-slide"> 
      <div class="banner-item">
        <div class="item">

        {% if banner.link %}
        <a href="{{ banner.link }}">
          <img src="{{ banner.image }}" alt="{{ banner.title }}" class="img-responsive" />
          </a>
          <div class="bexc-cont">
                    <h3><a href="{{ banner.link }}">{{ banner.title }}</a></h3>
                    <p><a href="{{ banner.link }}">{{ banner.description }}</a></p>
          </div>
        {% else %}

            <a href="{{ banner.link }}">
                <img src="{{ banner.image }}" alt="{{ banner.title }}" class="img-responsive" />
            </a>
            <div class="bexc-cont">
                    <h3><a href="{{ banner.link }}">{{ banner.title }}</a></h3>
                    <p><a href="{{ banner.link }}">{{ banner.description }}</a></p>
          </div>
        {% endif %}





        </div>

      </div>



</div>
      {% endfor %}
</div></div></div>


  </div>
<script type="text/javascript"><!--
        $('#carousel-banner33{{ module }}').swiper({
        mode: 'horizontal',
                slidesPerView: 5,
                // pagination: '.special0',
                paginationClickable: false,
                spaceBetween: 15,
                autoplay: 3000,
                speed: 700,


                autoplayDisableOnInteraction: true,
                loop: false,
                breakpoints: {
                    // when window width is <= 499px
                    768: {
                        slidesPerView: 3,
                        spaceBetween: 15,

                    },
                    499: {
                        slidesPerView: 2,
                        spaceBetween: 15,

                    },
                }
        });
        --></script>
 </div>
</div>

<div class="clearfix"></div>
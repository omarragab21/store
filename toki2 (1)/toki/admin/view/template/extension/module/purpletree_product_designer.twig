<style>
<!-- body {font-family: Arial, Helvetica, sans-serif;} -->
body {font-family: Arial, Helvetica, sans-serif;}

/* The Modal (background) */
.modal {
    display: none; /* Hidden by default */
    position: fixed; /* Stay in place */
    z-index: 1; /* Sit on top */
    padding-top: 100px; /* Location of the box */
    left: 0;
    top: 0;
    width: 100%; /* Full width */
    height: 100%; /* Full height */
    overflow: auto; /* Enable scroll if needed */
    background-color: rgb(0,0,0); /* Fallback color */
    background-color: rgba(0,0,0,0.4); /* Black w/ opacity */
}

/* Modal Content */
.modal-content {
    background-color: #fefefe;
    margin: auto;
    padding: 15px;
    border: 1px solid #888;
	width: 30%;
}
.mbutton{
margin-top: 62px;
margin-left: 282px;
}


/* The Close Button */
.close {
    color: #aaaaaa;
    float: right;
    font-size: 28px;
    font-weight: bold;
}

.close:hover,
.close:focus {
    color: #000;
    text-decoration: none;
    cursor: pointer;
}
.liceform .form-group {
margin:0;
}		
</style>
<script>
var modal = document.getElementById('licenseModal');
var btn = document.getElementById("getLicensee");
var span = document.getElementsByClassName("close")[0];
btn.onclick = function() {
    modal.style.display = "block";
	 $('#modal_lic_error').css('display','none');
}
span.onclick = function() {
    modal.style.display = "none";
	$('.orderdiv').css('display','none');
}


window.onclick = function(event) {
    if (event.target == modal) {
        modal.style.display = "none";
    }
}
</script>
<script>
function savelicc(){
	var licenskey1 = $('#licenskey1').val();
	if (licenskey1 == "") {
        $('#modal_lic_error').html("Enter license key");
		$('#modal_lic_error').css('display','block');
	    $('.alertseucess').css('display','none');
    } else {
	$('.alertseucess').text("License key has been Changed. Click on Save button to save changes");
		$('.alertseucess').css('display','block');
	$('#setlicensee').val(licenskey1);
		$('.orderdiv').css('display','none');
			   $('.close').click();
	}
}
function dontlice(){
	$('.orderdiv').css('display','block');
}
function getlicense(order_id,Email_id){
$('.getlicbtn').addClass('disabled');
$('.getlicbtn').val("{{ please_product_designer_wait }}");
var order_id = document.getElementById('order_id').value;
var email_id = document.getElementById('email_id').value;
    if (!order_id.match(/^\d+/)) {
				$('#modal_lic_error').html("{{ error_product_designer_order_id }}");
			    $('#modal_lic_error').css('display','block');
				$('.getlicbtn').removeClass('disabled');
			    $('.getlicbtn').val("{{ button_product_designer_submit }}");
	  return false;
    } 
    var atpos = email_id.indexOf("@");
    var dotpos = email_id.lastIndexOf(".");
    if (atpos<1 || dotpos<atpos+2 || dotpos+2>=email_id.length) {
		 $('#modal_lic_error').html("{{ error_swatches_email_id }}");
			    $('#modal_lic_error').css('display','block');
				$('.getlicbtn').removeClass('disabled');
			$('.getlicbtn').val("{{ button_product_designer_submit }}")
        return false;
    }
	$.ajax ({
            url: "https://process.purpletreesoftware.com/processorder.php",
            data:'order_id='+order_id+'&email_id='+email_id+'&module=purpletree_multivendor_oc',
			type: 'POST',
			dataType: "json",
            success: function( result ) {
			$('.getlicbtn').removeClass('disabled');
			$('.getlicbtn').val("{{ button_product_designer_submit }}")
			if(result.status == 'success') {
			$('.alertseucess').text("License key has been Changed. Click on Save button to save changes");
				$('.alertseucess').css('display','block');
               $('#setlicensee').val(result.process_data);
			   $('.orderdiv').css('display','none');
			   $('.close').click();
			   } else {
			    $('#modal_lic_error').html(result.msg);
			    $('#modal_lic_error').css('display','block');
			   }
            }
        });
    }
if($('#input-watermark-status').val()==1){
	$('#pts-watermark').show();
	}
$('#input-watermark-status').on('change',function(e){
if($(this).val()==1){
	$('#pts-watermark').show();
	}else{
	$('#pts-watermark').hide();	
	}
});
	
</script>
<script>

function ptsNumericFilter(e) {
   var k = e.which || e.keyCode;
    if ( (k >= 48 &&  57 >= k) || k==8 || k==46 || (k >= 96 &&  105 >= k)) {
        return true;
    } else {
		e.preventDefault();
        return false;
	}
};
function ptsFloatFilter(e) {
   var k = e.which || e.keyCode;
   console.log(k);
    if ( (k >= 48 &&  57 >= k) || k==8 || k==46 || k==190 || k==110 || (k >= 96 &&  105 >= k)) {
        return true;
    } else {
		e.preventDefault();
        return false;
	}
};
var option_row = {{ option_row }};
function addDesignOptionValue() {
	html  = '<tr class="imagrowclass" id="design-option-row' + option_row + '">';
	html += '  <td class="text-left"><input type="text" name="module_purpletree_product_designer_text['+option_row+'][pts_min]" id="input-min-text-value'+option_row+'" class="form-control" value="" onkeydown="ptsNumericFilter(event);"></td>';
	html += '  <td class="text-left"><input type="text" name="module_purpletree_product_designer_text['+option_row+'][pts_max]" id="input-max-text-val'+option_row+'" class="form-control" value="" onkeydown="ptsNumericFilter(event);"></td>';
	html += '  <td class="text-left"><input type="text" name="module_purpletree_product_designer_text['+option_row+'][pts_price]" id="input-price-text'+option_row+'" class="form-control" value="" onkeydown="ptsFloatFilter(event);"></td>';
	
	html += '<td class="text-left"><button type="button" onclick="$(\'#design-option-row'+option_row+'\').remove();" data-toggle="tooltip" title="" class="btn btn-danger" data-original-title="Remove"><i class="fa fa-minus-circle"></i></button></td> ';
	html += '</tr>';
	$('#ptsdesign_id > tbody').append(html);
	$('[rel=tooltip]').tooltip();
	option_row++;
}
</script>
